diff --git a/test/cancelOrder.test.js b/test/cancelOrder.test.js
new file mode 100644
index 0000000..445251c
--- /dev/null
+++ b/test/cancelOrder.test.js
@@ -0,0 +1,142 @@
+import assert from 'node:assert/strict';
+import { describe, it } from 'node:test';
+
+import { FakePaymentGateway } from '../src/index.js';
+import { CUSTOMER, testStore } from './helpers.js';
+
+const ITEMS = [{ sku: 'TEC-040', quantity: 2 }];
+
+async function pending(options) {
+  const store = testStore(options);
+  const order = await store.orders.placeOrder({ customer: CUSTOMER, items: ITEMS });
+  return { store, order };
+}
+
+async function paid(options) {
+  const ctx = await pending(options);
+  await ctx.store.orders.payOrder(ctx.order.id, 'pix');
+  return ctx;
+}
+
+describe('cancelOrder', () => {
+  it('pendente: cancela, libera a reserva e não estorna', async () => {
+    const { store, order } = await pending();
+    const before = store.inventory.available('TEC-040');
+    const result = await store.orders.cancelOrder(order.id, '  desisti  ');
+    assert.equal(result, order);
+    assert.equal(order.status, 'cancelled');
+    assert.equal(order.cancelReason, 'desisti');
+    assert.equal(order.cancelledAt, '2026-03-10T12:00:00.000Z');
+    assert.deepEqual(order.history.at(-1), { status: 'cancelled', at: '2026-03-10T12:00:00.000Z', reason: 'desisti' });
+    assert.equal(store.inventory.reservationOf(order.id), null);
+    assert.equal(store.inventory.available('TEC-040'), before + 2);
+    assert.equal(store.gateway.refunds.length, 0);
+    assert.deepEqual(store.bus.emitted('order.cancelled')[0], {
+      orderId: order.id,
+      email: 'ana@example.com',
+      name: 'Ana Souza',
+      reason: 'desisti',
+      refunded: false,
+    });
+    assert.equal(order.toJSON().cancelReason, 'desisti');
+  });
+
+  it('pago: estorna o total e devolve os itens ao estoque', async () => {
+    const { store, order } = await paid();
+    assert.equal(store.inventory.onHand('TEC-040'), 6);
+    await store.orders.cancelOrder(order.id, 'defeito');
+    assert.equal(order.status, 'cancelled');
+    assert.equal(store.gateway.refunds.length, 1);
+    assert.equal(store.gateway.refunds[0].paymentId, order.payment.paymentId);
+    assert.equal(store.gateway.refunds[0].amount, order.totals.total);
+    assert.equal(store.inventory.onHand('TEC-040'), 8);
+    assert.equal(store.bus.emitted('order.cancelled')[0].refunded, true);
+  });
+
+  it('estorno recusado: REFUND_FAILED, segue paid, estoque igual, sem evento', async () => {
+    const gateway = new FakePaymentGateway();
+    gateway.refund = async () => ({ ok: false, reason: 'gateway_down' });
+    const { store, order } = await paid({ gateway });
+    const snapshot = store.inventory.snapshot();
+    await assert.rejects(store.orders.cancelOrder(order.id, 'x'), {
+      code: 'REFUND_FAILED',
+      details: { reason: 'gateway_down' },
+    });
+    assert.equal(order.status, 'paid');
+    assert.equal(order.cancelReason, null);
+    assert.deepEqual(store.inventory.snapshot(), snapshot);
+    assert.equal(store.bus.emitted('order.cancelled').length, 0);
+  });
+
+  it('motivo ausente, vazio ou só espaços: VALIDATION_ERROR e pedido intacto', async () => {
+    const { store, order } = await pending();
+    for (const reason of [undefined, '', '   ']) {
+      await assert.rejects(store.orders.cancelOrder(order.id, reason), { code: 'VALIDATION_ERROR' });
+    }
+    assert.equal(order.status, 'pending');
+    assert.notEqual(store.inventory.reservationOf(order.id), null);
+    assert.equal(store.bus.emitted('order.cancelled').length, 0);
+  });
+
+  it('pedido inexistente: ORDER_NOT_FOUND', async () => {
+    const store = testStore();
+    await assert.rejects(store.orders.cancelOrder('ORD-9999', 'x'), { code: 'ORDER_NOT_FOUND' });
+  });
+
+  it('status não cancelável: ORDER_NOT_CANCELLABLE', async () => {
+    const gateway = new FakePaymentGateway({ script: [{ ok: false, retryable: false, reason: 'card_declined' }] });
+    const failed = await pending({ gateway });
+    await failed.store.orders.payOrder(failed.order.id, 'pix');
+    await assert.rejects(failed.store.orders.cancelOrder(failed.order.id, 'x'), {
+      code: 'ORDER_NOT_CANCELLABLE',
+      details: { status: 'payment_failed' },
+    });
+
+    const shipped = await paid();
+    shipped.store.orders.shipOrder(shipped.order.id, 'BR1');
+    await assert.rejects(shipped.store.orders.cancelOrder(shipped.order.id, 'x'), { code: 'ORDER_NOT_CANCELLABLE' });
+    shipped.store.orders.deliverOrder(shipped.order.id);
+    await assert.rejects(shipped.store.orders.cancelOrder(shipped.order.id, 'x'), {
+      code: 'ORDER_NOT_CANCELLABLE',
+      details: { status: 'delivered' },
+    });
+    assert.equal(shipped.store.gateway.refunds.length, 0);
+  });
+
+  it('cancelar duas vezes: a segunda falha e só há um estorno', async () => {
+    const { store, order } = await paid();
+    await store.orders.cancelOrder(order.id, 'x');
+    await assert.rejects(store.orders.cancelOrder(order.id, 'y'), {
+      code: 'ORDER_NOT_CANCELLABLE',
+      details: { status: 'cancelled' },
+    });
+    assert.equal(store.gateway.refunds.length, 1);
+    assert.equal(store.inventory.onHand('TEC-040'), 8);
+  });
+
+  it('cancelamentos concorrentes do pago: um só estorno', async () => {
+    const { store, order } = await paid();
+    const results = await Promise.allSettled([
+      store.orders.cancelOrder(order.id, 'a'),
+      store.orders.cancelOrder(order.id, 'b'),
+      store.orders.cancelOrder(order.id, 'c'),
+    ]);
+    assert.equal(results.filter((r) => r.status === 'fulfilled').length, 1);
+    for (const r of results.filter((item) => item.status === 'rejected')) {
+      assert.equal(r.reason.code, 'ORDER_NOT_CANCELLABLE');
+    }
+    assert.equal(store.gateway.refunds.length, 1);
+    assert.equal(store.inventory.onHand('TEC-040'), 8);
+    assert.equal(store.bus.emitted('order.cancelled').length, 1);
+  });
+
+  it('avisa o cliente com o assunto do cancelamento', async () => {
+    const { store, order } = await paid();
+    await store.orders.cancelOrder(order.id, 'defeito');
+    const message = store.transport.sent.at(-1);
+    assert.equal(message.subject, 'Pedido ORD-0001 cancelado');
+    assert.ok(message.body.includes('defeito'));
+    assert.ok(message.body.includes('estornado'));
+    assert.equal(message.to, 'ana@example.com');
+  });
+});
