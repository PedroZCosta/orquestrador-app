@@ -0,0 +1,221 @@
+import assert from 'node:assert/strict';
+import { describe, it } from 'node:test';
+
+import { FakePaymentGateway, ORDER_STATUSES } from '../src/index.js';
+import { formatReport, salesReport } from '../src/reports/salesReport.js';
+import { CUSTOMER, testStore } from './helpers.js';
+
+/** Gateway cujo `refund` responde o que o teste mandar, contando as chamadas. */
+class RefusingGateway extends FakePaymentGateway {
+  constructor(answer) {
+    super();
+    this.answer = answer;
+    this.refundCalls = 0;
+  }
+
+  async refund() {
+    this.refundCalls += 1;
+    return this.answer;
+  }
+}
+
+describe('OrderService#cancelOrder', () => {
+  it('cancelled é um status conhecido', () => {
+    assert.ok(ORDER_STATUSES.includes('cancelled'));
+  });
+
+  it('pedido pendente: desfaz a reserva, não estorna e registra motivo, data e histórico', async () => {
+    const store = testStore();
+    const order = await store.orders.placeOrder({ customer: CUSTOMER, items: [{ sku: 'TEC-040', quantity: 2 }] });
+    assert.equal(store.inventory.available('TEC-040'), 6);
+
+    store.clock.advance(60_000);
+    const cancelled = await store.orders.cancelOrder(order.id, '  desisti da compra  ');
+
+    assert.equal(cancelled, order);
+    assert.equal(order.status, 'cancelled');
+    assert.equal(order.cancelReason, 'desisti da compra');
+    assert.equal(order.cancelledAt, '2026-03-10T12:01:00.000Z');
+    assert.equal(order.updatedAt, '2026-03-10T12:01:00.000Z');
+    assert.deepEqual(order.history.at(-1), {
+      status: 'cancelled',
+      at: '2026-03-10T12:01:00.000Z',
+      reason: 'desisti da compra',
+    });
+    assert.equal(store.inventory.available('TEC-040'), 8);
+    assert.equal(store.inventory.onHand('TEC-040'), 8);
+    assert.equal(store.inventory.reservationOf(order.id), null);
+    assert.equal(store.gateway.refunds.length, 0);
+    assert.deepEqual(store.bus.emitted('order.cancelled'), [
+      { orderId: order.id, email: CUSTOMER.email, name: CUSTOMER.name, reason: 'desisti da compra', refunded: false },
+    ]);
+    assert.equal(order.toJSON().cancelReason, 'desisti da compra');
+    assert.equal(order.toJSON().cancelledAt, '2026-03-10T12:01:00.000Z');
+  });
+
+  it('pedido pago: estorna o total uma vez e devolve os itens ao estoque físico', async () => {
+    const store = testStore();
+    const order = await store.orders.placeOrder({ customer: CUSTOMER, items: [{ sku: 'TEC-040', quantity: 2 }] });
+    await store.orders.payOrder(order.id, 'credit_card');
+    assert.equal(store.inventory.onHand('TEC-040'), 6);
+
+    await store.orders.cancelOrder(order.id, 'produto com defeito');
+
+    assert.equal(order.status, 'cancelled');
+    assert.deepEqual(store.gateway.refunds, [
+      { paymentId: order.payment.paymentId, amount: order.totals.total, refundId: 'REF-0001' },
+    ]);
+    assert.equal(order.payment.refundId, 'REF-0001');
+    assert.equal(order.payment.refundedAt, order.cancelledAt);
+    assert.equal(store.inventory.onHand('TEC-040'), 8);
+    assert.equal(store.inventory.available('TEC-040'), 8);
+    assert.deepEqual(
+      order.history.map((entry) => entry.status),
+      ['pending', 'paid', 'cancelled'],
+    );
+    assert.equal(store.bus.emitted('order.cancelled')[0].refunded, true);
+  });
+
+  it('estorno recusado: REFUND_FAILED, pedido continua pago e o estoque não muda', async () => {
+    const gateway = new RefusingGateway({ ok: false, reason: 'refund_window_expired' });
+    const store = testStore({ gateway });
+    const order = await store.orders.placeOrder({ customer: CUSTOMER, items: [{ sku: 'TEC-040', quantity: 2 }] });
+    await store.orders.payOrder(order.id, 'pix');
+    const before = store.inventory.snapshot();
+
+    await assert.rejects(store.orders.cancelOrder(order.id, 'arrependimento'), {
+      code: 'REFUND_FAILED',
+      details: { paymentId: order.payment.paymentId, reason: 'refund_window_expired' },
+    });
+
+    assert.equal(gateway.refundCalls, 1);
+    assert.equal(order.status, 'paid');
+    assert.equal(order.cancelReason, null);
+    assert.equal(order.cancelledAt, null);
+    assert.equal(order.payment.refundId, undefined);
+    assert.deepEqual(store.inventory.snapshot(), before);
+    assert.equal(store.bus.emitted('order.cancelled').length, 0);
+  });
+
+  it('motivo obrigatório: VALIDATION_ERROR sem mexer no pedido', async () => {
+    const store = testStore();
+    const order = await store.orders.placeOrder({ customer: CUSTOMER, items: [{ sku: 'CAN-010', quantity: 1 }] });
+    for (const reason of [undefined, null, '', '   ', 42]) {
+      await assert.rejects(store.orders.cancelOrder(order.id, reason), { code: 'VALIDATION_ERROR' });
+    }
+    assert.equal(order.status, 'pending');
+    assert.notEqual(store.inventory.reservationOf(order.id), null);
+  });
+
+  it('pedido inexistente: ORDER_NOT_FOUND', async () => {
+    const store = testStore();
+    await assert.rejects(store.orders.cancelOrder('ORD-9999', 'teste'), { code: 'ORDER_NOT_FOUND' });
+  });
+
+  it('só cancela pending ou paid: os demais status dão ORDER_NOT_CANCELLABLE', async () => {
+    const gateway = new FakePaymentGateway({
+      script: [{ ok: false, retryable: false, reason: 'card_declined' }],
+    });
+    const store = testStore({ gateway });
+    const failed = await store.orders.placeOrder({ customer: CUSTOMER, items: [{ sku: 'CAN-010', quantity: 1 }] });
+    await store.orders.payOrder(failed.id, 'credit_card');
+
+    const shipped = await store.orders.placeOrder({ customer: CUSTOMER, items: [{ sku: 'CAN-010', quantity: 1 }] });
+    await store.orders.payOrder(shipped.id, 'pix');
+    store.orders.shipOrder(shipped.id, 'BR1');
+
+    const delivered = await store.orders.placeOrder({ customer: CUSTOMER, items: [{ sku: 'CAN-010', quantity: 1 }] });
+    await store.orders.payOrder(delivered.id, 'pix');
+    store.orders.shipOrder(delivered.id, 'BR2');
+    store.orders.deliverOrder(delivered.id);
+
+    const cancelled = await store.orders.placeOrder({ customer: CUSTOMER, items: [{ sku: 'CAN-010', quantity: 1 }] });
+    await store.orders.cancelOrder(cancelled.id, 'primeiro cancelamento');
+
+    for (const order of [failed, shipped, delivered, cancelled]) {
+      const status = order.status;
+      await assert.rejects(store.orders.cancelOrder(order.id, 'outro motivo'), {
+        code: 'ORDER_NOT_CANCELLABLE',
+        details: { status },
+      });
+      assert.equal(order.status, status);
+    }
+    assert.equal(cancelled.cancelReason, 'primeiro cancelamento');
+    assert.equal(store.bus.emitted('order.cancelled').length, 1);
+    assert.equal(store.gateway.refunds.length, 0);
+  });
+
+  it('pedido pago cancelado duas vezes estorna uma vez só', async () => {
+    const store = testStore();
+    const order = await store.orders.placeOrder({ customer: CUSTOMER, items: [{ sku: 'TEC-040', quantity: 1 }] });
+    await store.orders.payOrder(order.id, 'pix');
+
+    const results = await Promise.allSettled([
+      store.orders.cancelOrder(order.id, 'primeiro'),
+      store.orders.cancelOrder(order.id, 'segundo'),
+    ]);
+
+    assert.equal(results[0].status, 'fulfilled');
+    assert.equal(results[1].status, 'rejected');
+    assert.equal(results[1].reason.code, 'ORDER_NOT_CANCELLABLE');
+    assert.equal(store.gateway.refunds.length, 1);
+    assert.equal(order.cancelReason, 'primeiro');
+    assert.equal(store.inventory.onHand('TEC-040'), 8);
+  });
+
+  it('não cancela enquanto a cobrança está em andamento', async () => {
+    const store = testStore();
+    const order = await store.orders.placeOrder({ customer: CUSTOMER, items: [{ sku: 'TEC-040', quantity: 1 }] });
+    const paying = store.orders.payOrder(order.id, 'pix');
+    await assert.rejects(store.orders.cancelOrder(order.id, 'pressa'), { code: 'ORDER_NOT_CANCELLABLE' });
+    await paying;
+    assert.equal(order.status, 'paid');
+    await store.orders.cancelOrder(order.id, 'agora sim');
+    assert.equal(order.status, 'cancelled');
+    assert.equal(store.gateway.refunds.length, 1);
+  });
+
+  it('avisa o cliente do cancelamento', async () => {
+    const store = testStore();
+    const pending = await store.orders.placeOrder({ customer: CUSTOMER, items: [{ sku: 'CAN-010', quantity: 1 }] });
+    const paid = await store.orders.placeOrder({ customer: CUSTOMER, items: [{ sku: 'CAN-010', quantity: 1 }] });
+    await store.orders.payOrder(paid.id, 'pix');
+    await store.orders.cancelOrder(pending.id, 'desisti');
+    await store.orders.cancelOrder(paid.id, 'atraso na entrega');
+
+    const messages = store.transport.sent.filter((message) => message.type === 'order.cancelled');
+    assert.deepEqual(
+      messages.map((message) => [message.to, message.subject]),
+      [
+        [CUSTOMER.email, `Pedido ${pending.id} cancelado`],
+        [CUSTOMER.email, `Pedido ${paid.id} cancelado`],
+      ],
+    );
+    assert.ok(messages[0].body.startsWith(`Olá, ${CUSTOMER.name}. O pedido ${pending.id} foi cancelado (desisti).`));
+    assert.ok(messages[0].body.includes('Nenhuma cobrança foi feita.'));
+    assert.ok(messages[1].body.includes('(atraso na entrega)'));
+    assert.ok(messages[1].body.includes('estornado'));
+    assert.ok(messages[1].body.endsWith('Loja Dev\nDúvidas: atendimento@lojadev.example'));
+  });
+
+  it('o relatório de vendas ignora pedidos cancelados', async () => {
+    const store = testStore();
+    const kept = await store.orders.placeOrder({ customer: CUSTOMER, items: [{ sku: 'LIV-001', quantity: 1 }] });
+    const pending = await store.orders.placeOrder({ customer: CUSTOMER, items: [{ sku: 'CAN-010', quantity: 1 }] });
+    const paid = await store.orders.placeOrder({
+      customer: { ...CUSTOMER, state: 'RJ' },
+      items: [{ sku: 'TEC-040', quantity: 1 }],
+    });
+    await store.orders.payOrder(kept.id, 'pix');
+    await store.orders.payOrder(paid.id, 'pix');
+    await store.orders.cancelOrder(pending.id, 'desisti');
