+  /**
+   * Cancela um pedido pendente ou pago.
+   *
+   * - Pendente: desfaz a reserva de estoque; não houve cobrança.
+   * - Pago: estorna o total pelo gateway (uma vez só) e devolve os itens ao
+   *   estoque físico. Se o estorno for recusado, lança `REFUND_FAILED` e o
+   *   pedido continua pago, com o estoque intocado.
+   */
+  async cancelOrder(orderId, reason) {
+    const order = this.repository.get(orderId);
+    const why = requireString(reason, 'reason');
+    if (!order.canTransitionTo('cancelled') || this.inFlight.has(orderId)) {
+      throw new DomainError('ORDER_NOT_CANCELLABLE', `O pedido ${orderId} está ${order.status} e não pode ser cancelado.`, {
+        status: order.status,
+      });
+    }
+
+    let refund = null;
+    if (order.status === 'paid') {
+      const { paymentId } = order.payment;
+      this.inFlight.add(orderId);
+      let result;
+      try {
+        result = await this.payments.refund({ orderId, paymentId, amount: order.totals.total });
+      } finally {
+        this.inFlight.delete(orderId);
+      }
+      if (!result.ok) {
+        throw new DomainError('REFUND_FAILED', `O estorno do pedido ${orderId} foi recusado (${result.reason}).`, {
+          paymentId,
+          reason: result.reason,
+        });
+      }
+      refund = { refundId: result.refundId };
+    }
+
+    order.markCancelled({ reason: why, refund }, this.now().toISOString());
+    if (refund === null) {
+      this.inventory.release(orderId);
+    } else {
+      for (const line of order.lines) {
+        this.inventory.addStock(line.sku, line.quantity);
+      }
+    }
+    this.repository.save(order);
+    this.logger?.info('Pedido cancelado', { orderId, refunded: refund !== null });
+    this.bus.emit('order.cancelled', {
+      orderId,
+      email: order.customer.email,
+      name: order.customer.name,
+      reason: why,
+      refunded: refund !== null,
+    });
+    return order;
+  }
 }
