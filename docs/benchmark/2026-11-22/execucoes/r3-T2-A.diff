+  /**
+   * Cancela um pedido pendente ou pago. Pendente: a reserva de estoque é
+   * desfeita. Pago: o total é estornado pelo gateway e os itens voltam ao
+   * estoque físico; se o estorno for recusado, nada muda e lança REFUND_FAILED.
+   */
+  async cancelOrder(orderId, reason) {
+    const order = this.repository.get(orderId);
+    const why = requireString(reason, 'reason');
+    const busy = this.inFlight.has(orderId);
+    if (busy || !order.canTransitionTo('cancelled')) {
+      throw new DomainError(
+        'ORDER_NOT_CANCELLABLE',
+        busy
+          ? `O pedido ${orderId} tem uma operação de pagamento em andamento.`
+          : `O pedido ${orderId} está ${order.status} e não pode ser cancelado.`,
+        { status: order.status, ...(busy ? { inProgress: true } : {}) },
+      );
+    }
+
+    let refundId = null;
+    if (order.status === 'paid') {
+      this.inFlight.add(orderId);
+      let refund;
+      try {
+        refund = await this.payments.refund({
+          orderId,
+          paymentId: order.payment.paymentId,
+          amount: order.totals.total,
+        });
+      } finally {
+        this.inFlight.delete(orderId);
+      }
+      if (!refund.ok) {
+        throw new DomainError('REFUND_FAILED', `O estorno do pedido ${orderId} foi recusado (${refund.reason}).`, {
+          reason: refund.reason,
+          paymentId: order.payment.paymentId,
+        });
+      }
+      refundId = refund.refundId;
+      for (const line of order.lines) {
+        this.inventory.addStock(line.sku, line.quantity);
+      }
+    } else {
+      this.inventory.release(orderId);
+    }
+
