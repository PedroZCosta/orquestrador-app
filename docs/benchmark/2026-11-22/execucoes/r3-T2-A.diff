+
+async function paidOrder(store, items = [{ sku: 'TEC-040', quantity: 2 }]) {
+  const order = await store.orders.placeOrder({ customer: CUSTOMER, items });
+  await store.orders.payOrder(order.id, 'credit_card');
+  return order;
+}
+
+describe('OrderService#cancelOrder', () => {
