+    const store = testStore();
+    const order = await store.orders.placeOrder({ customer: CUSTOMER, items: [{ sku: 'MOU-030', quantity: 3 }] });
+    assert.equal(store.inventory.available('MOU-030'), 12);
+    store.clock.advance(60_000);
+
+    const cancelled = await store.orders.cancelOrder(order.id, '  Desisti da compra  ');
+
+    assert.equal(cancelled, order);
+    assert.equal(order.status, 'cancelled');
+    assert.equal(order.cancelReason, 'Desisti da compra');
+    assert.equal(order.cancelledAt, '2026-03-10T12:01:00.000Z');
+    assert.equal(order.updatedAt, '2026-03-10T12:01:00.000Z');
+    assert.deepEqual(order.history.at(-1), {
+      status: 'cancelled',
+      at: '2026-03-10T12:01:00.000Z',
+      reason: 'Desisti da compra',
+    });
+    assert.equal(store.inventory.available('MOU-030'), 15);
+    assert.equal(store.inventory.onHand('MOU-030'), 15);
+    assert.equal(store.inventory.reservationOf(order.id), null);
+    assert.equal(store.gateway.refunds.length, 0);
+    assert.equal(order.toJSON().cancelReason, 'Desisti da compra');
+    assert.equal(order.toJSON().cancelledAt, '2026-03-10T12:01:00.000Z');
+  });
+
+  it('pedido pago: estorna o total uma vez e devolve os itens ao estoque físico', async () => {
