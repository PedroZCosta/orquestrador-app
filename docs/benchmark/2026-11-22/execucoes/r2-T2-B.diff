diff --git a/test/orderService.test.js b/test/orderService.test.js
index c3b715c..074a01a 100644
--- a/test/orderService.test.js
+++ b/test/orderService.test.js
@@ -76,3 +76,101 @@ describe('OrderService', () => {
     assert.throws(() => store.orders.getOrder('ORD-9999'), { code: 'ORDER_NOT_FOUND' });
   });
 });
+
+describe('OrderService#cancelOrder', () => {
+  const place = (store, sku = 'TEC-040', quantity = 2) =>
+    store.orders.placeOrder({ customer: CUSTOMER, items: [{ sku, quantity }] });
+
+  it('pedido pendente: libera a reserva, sem estorno', async () => {
+    const store = testStore();
+    const order = await place(store);
+    const result = await store.orders.cancelOrder(order.id, '  desisti  ');
+    assert.equal(result, order);
+    assert.equal(order.status, 'cancelled');
+    assert.equal(order.cancelReason, 'desisti');
+    assert.equal(order.cancelledAt, '2026-03-10T12:00:00.000Z');
+    assert.deepEqual(order.history.map((entry) => entry.status), ['pending', 'cancelled']);
+    assert.equal(store.inventory.available('TEC-040'), 8);
+    assert.equal(store.gateway.refunds.length, 0);
+    assert.deepEqual(store.bus.emitted('order.cancelled'), [
+      { orderId: order.id, email: 'ana@example.com', name: 'Ana Souza', reason: 'desisti', refunded: false },
+    ]);
+    assert.equal(store.transport.sent.at(-1).subject, `Pedido ${order.id} cancelado`);
+  });
+
+  it('pedido pago: estorna o total uma vez e devolve ao estoque físico', async () => {
+    const store = testStore();
+    const order = await place(store);
+    await store.orders.payOrder(order.id, 'pix');
+    assert.equal(store.inventory.onHand('TEC-040'), 6);
+    await store.orders.cancelOrder(order.id, 'arrependimento');
+    assert.equal(order.status, 'cancelled');
+    assert.equal(store.inventory.onHand('TEC-040'), 8);
+    assert.equal(store.inventory.available('TEC-040'), 8);
+    assert.equal(store.gateway.refunds.length, 1);
+    assert.equal(store.gateway.refunds[0].paymentId, 'PAY-0001');
+    assert.equal(store.gateway.refunds[0].amount, order.totals.total);
+    assert.equal(store.bus.emitted('order.cancelled')[0].refunded, true);
+    await assert.rejects(store.orders.cancelOrder(order.id, 'de novo'), { code: 'ORDER_NOT_CANCELLABLE' });
+    assert.equal(store.gateway.refunds.length, 1);
+  });
+
+  it('cancelamentos simultâneos de pedido pago estornam uma vez só', async () => {
+    const store = testStore();
+    const order = await place(store);
+    await store.orders.payOrder(order.id, 'pix');
+    const results = await Promise.allSettled([
+      store.orders.cancelOrder(order.id, 'a'),
+      store.orders.cancelOrder(order.id, 'b'),
+    ]);
+    assert.deepEqual(results.map((r) => r.status).sort(), ['fulfilled', 'rejected']);
+    assert.equal(results.find((r) => r.status === 'rejected').reason.code, 'ORDER_NOT_CANCELLABLE');
+    assert.equal(store.gateway.refunds.length, 1);
+    assert.equal(store.inventory.onHand('TEC-040'), 8);
+  });
+
+  it('estorno recusado: REFUND_FAILED, continua pago e o estoque não muda', async () => {
+    const store = testStore();
+    const order = await place(store);
+    await store.orders.payOrder(order.id, 'pix');
+    store.gateway.refund = async () => ({ ok: false, reason: 'gateway_down' });
+    await assert.rejects(store.orders.cancelOrder(order.id, 'x'), { code: 'REFUND_FAILED' });
+    assert.equal(order.status, 'paid');
+    assert.equal(order.cancelReason, null);
+    assert.equal(store.inventory.onHand('TEC-040'), 6);
+    assert.equal(store.bus.emitted('order.cancelled').length, 0);
+    delete store.gateway.refund;
+    await store.orders.cancelOrder(order.id, 'tentativa 2');
+    assert.equal(order.status, 'cancelled');
+  });
+
+  it('exige motivo e pedido existente', async () => {
+    const store = testStore();
+    const order = await place(store);
+    for (const reason of [undefined, '', '   ', 42]) {
+      await assert.rejects(store.orders.cancelOrder(order.id, reason), { code: 'VALIDATION_ERROR' });
+    }
+    assert.equal(order.status, 'pending');
+    await assert.rejects(store.orders.cancelOrder('ORD-9999', 'x'), { code: 'ORDER_NOT_FOUND' });
+  });
+
+  it('não cancela pedido enviado, entregue, com pagamento recusado ou já cancelado', async () => {
+    const gateway = new FakePaymentGateway({ script: [{ ok: true }, { ok: true }, { ok: false, reason: 'card_declined' }] });
+    const store = testStore({ gateway });
+    const shipped = await place(store, 'CAM-020', 1);
+    const delivered = await place(store, 'CAM-020', 1);
+    const failed = await place(store, 'CAM-020', 1);
+    const cancelled = await place(store, 'CAM-020', 1);
+    await store.orders.payOrder(shipped.id, 'pix');
+    await store.orders.payOrder(delivered.id, 'pix');
+    await store.orders.payOrder(failed.id, 'pix');
+    store.orders.shipOrder(shipped.id, 'br1');
+    store.orders.shipOrder(delivered.id, 'br2');
+    store.orders.deliverOrder(delivered.id);
+    await store.orders.cancelOrder(cancelled.id, 'x');
+    for (const id of [shipped.id, delivered.id, failed.id, cancelled.id]) {
+      await assert.rejects(store.orders.cancelOrder(id, 'x'), { code: 'ORDER_NOT_CANCELLABLE' });
+    }
+    assert.equal(store.gateway.refunds.length, 0);
+  });
+});
