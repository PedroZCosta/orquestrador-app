diff --git a/test/cancelOrder.test.js b/test/cancelOrder.test.js
new file mode 100644
index 0000000..546afa1
--- /dev/null
+++ b/test/cancelOrder.test.js
@@ -0,0 +1,130 @@
+import assert from 'node:assert/strict';
+import { describe, it } from 'node:test';
+
+import { ORDER_STATUSES, salesReport } from '../src/index.js';
+import { CUSTOMER, testStore } from './helpers.js';
+
+const ITEMS = [{ sku: 'LIV-001', quantity: 2 }];
+
+async function pending(store) {
+  return store.orders.placeOrder({ customer: CUSTOMER, items: ITEMS });
+}
+
+async function paid(store) {
+  const order = await pending(store);
+  return store.orders.payOrder(order.id, 'pix');
+}
+
+describe('OrderService#cancelOrder', () => {
+  it('registra o status cancelled', () => {
+    assert.ok(ORDER_STATUSES.includes('cancelled'));
+  });
+
+  it('exige motivo não vazio', async () => {
+    const store = testStore();
+    const order = await pending(store);
+    for (const reason of [undefined, '', '   ', 42]) {
+      await assert.rejects(store.orders.cancelOrder(order.id, reason), { code: 'VALIDATION_ERROR' });
+    }
+    assert.equal(store.orders.getOrder(order.id).status, 'pending');
+  });
+
+  it('pedido inexistente: ORDER_NOT_FOUND', async () => {
+    const store = testStore();
+    await assert.rejects(store.orders.cancelOrder('ORD-999', 'x'), { code: 'ORDER_NOT_FOUND' });
+  });
+
+  it('pendente: desfaz a reserva, sem estorno', async () => {
+    const store = testStore();
+    const before = store.inventory.snapshot()['LIV-001'];
+    const order = await pending(store);
+    const result = await store.orders.cancelOrder(order.id, ' desisti ');
+    assert.equal(result.status, 'cancelled');
+    assert.equal(result.cancelReason, 'desisti');
+    assert.equal(result.cancelledAt, '2026-03-10T12:00:00.000Z');
+    assert.equal(result.history.at(-1).status, 'cancelled');
+    assert.deepEqual(store.inventory.snapshot()['LIV-001'], before);
+    assert.equal(store.inventory.reservationOf(order.id), null);
+    assert.equal(store.gateway.refunds.length, 0);
+  });
+
+  it('pago: estorna o total uma vez e devolve os itens ao estoque', async () => {
+    const store = testStore();
+    const before = store.inventory.snapshot()['LIV-001'];
+    const order = await paid(store);
+    assert.equal(store.inventory.onHand('LIV-001'), before.onHand - 2);
+    const result = await store.orders.cancelOrder(order.id, 'defeito');
+    assert.equal(result.status, 'cancelled');
+    assert.deepEqual(store.gateway.refunds.map(({ paymentId, amount }) => ({ paymentId, amount })), [
+      { paymentId: order.payment.paymentId, amount: order.totals.total },
+    ]);
+    assert.deepEqual(store.inventory.snapshot()['LIV-001'], before);
+  });
+
+  it('chamadas concorrentes estornam uma só vez', async () => {
+    const store = testStore();
+    const order = await paid(store);
+    const results = await Promise.allSettled([
+      store.orders.cancelOrder(order.id, 'a'),
+      store.orders.cancelOrder(order.id, 'b'),
+    ]);
+    assert.equal(results.filter((r) => r.status === 'fulfilled').length, 1);
+    assert.equal(results.find((r) => r.status === 'rejected').reason.code, 'ORDER_NOT_CANCELLABLE');
+    assert.equal(store.gateway.refunds.length, 1);
+  });
+
+  it('estorno recusado: REFUND_FAILED, pedido segue paid e estoque intacto', async () => {
+    const store = testStore();
+    const order = await paid(store);
+    const stock = store.inventory.snapshot();
+    store.gateway.refund = async () => ({ ok: false, reason: 'gateway_down' });
+    await assert.rejects(store.orders.cancelOrder(order.id, 'x'), { code: 'REFUND_FAILED' });
+    const after = store.orders.getOrder(order.id);
+    assert.equal(after.status, 'paid');
+    assert.equal(after.cancelReason, null);
+    assert.deepEqual(store.inventory.snapshot(), stock);
+    // Pode tentar de novo depois.
+    delete store.gateway.refund;
+    assert.equal((await store.orders.cancelOrder(order.id, 'x')).status, 'cancelled');
+  });
+
+  it('não cancela outros status nem pedido já cancelado', async () => {
+    const store = testStore();
+    const shipped = await paid(store);
+    store.orders.shipOrder(shipped.id, 'br1');
+    await assert.rejects(store.orders.cancelOrder(shipped.id, 'x'), { code: 'ORDER_NOT_CANCELLABLE' });
+
+    const done = await pending(store);
+    await store.orders.cancelOrder(done.id, 'x');
+    await assert.rejects(store.orders.cancelOrder(done.id, 'y'), { code: 'ORDER_NOT_CANCELLABLE' });
+  });
+
+  it('emite order.cancelled e avisa o cliente', async () => {
+    const store = testStore();
+    const events = [];
+    store.bus.on('order.cancelled', (payload) => events.push(payload));
+    const order = await paid(store);
+    await store.orders.cancelOrder(order.id, 'defeito');
+    assert.deepEqual(events, [
+      { orderId: order.id, email: CUSTOMER.email, name: CUSTOMER.name, reason: 'defeito', refunded: true },
+    ]);
+    const message = store.transport.sent.find((m) => m.type === 'order.cancelled');
+    assert.equal(message.subject, `Pedido ${order.id} cancelado`);
+    assert.equal(message.to, CUSTOMER.email);
+    assert.match(message.body, /defeito/);
+
+    const other = await pending(store);
+    await store.orders.cancelOrder(other.id, 'x');
+    assert.equal(events.at(-1).refunded, false);
+  });
+
+  it('salesReport ignora pedidos cancelados', async () => {
+    const store = testStore();
+    const keep = await paid(store);
+    const gone = await paid(store);
+    await store.orders.cancelOrder(gone.id, 'x');
+    const report = salesReport(store.orders.listOrders());
+    assert.equal(report.orderCount, 1);
+    assert.equal(report.revenue, keep.totals.total);
+  });
+});
