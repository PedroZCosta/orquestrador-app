+  /**
+   * Cancela um pedido pendente (desfaz a reserva) ou pago (estorna o total no
+   * gateway e devolve os itens ao estoque). Se o estorno for recusado, nada muda.
+   */
+  async cancelOrder(orderId, reason) {
+    const why = requireString(reason, 'reason');
+    const order = this.repository.get(orderId);
+    // Chamadas concorrentes: só uma segue, para o estorno acontecer uma vez.
+    if (this.cancelling.has(orderId) || !['pending', 'paid'].includes(order.status)) {
+      throw new DomainError('ORDER_NOT_CANCELLABLE', `O pedido ${orderId} está ${order.status} e não pode ser cancelado.`, {
+        status: order.status,
+      });
+    }
+    this.cancelling.add(orderId);
+    try {
+      const wasPaid = order.status === 'paid';
+      if (wasPaid) {
+        let result;
+        try {
+          result = await this.payments.gateway.refund({
+            paymentId: order.payment.paymentId,
+            amount: order.totals.total,
+          });
+        } catch (error) {
+          result = { ok: false, reason: error?.message ?? 'gateway_error' };
+        }
+        if (!result?.ok) {
+          throw new DomainError('REFUND_FAILED', `O gateway recusou o estorno do pedido ${orderId}.`, {
+            orderId,
+            reason: result?.reason,
+          });
+        }
+        for (const line of order.lines) {
+          this.inventory.addStock(line.sku, line.quantity);
+        }
+      } else {
+        this.inventory.release(orderId);
+      }
+      order.markCancelled(why, this.now().toISOString(), { refunded: wasPaid });
+      this.repository.save(order);
+      this.logger?.info('Pedido cancelado', { orderId, refunded: wasPaid });
+      this.bus.emit('order.cancelled', {
+        orderId,
+        email: order.customer.email,
+        name: order.customer.name,
+        reason: why,
+        refunded: wasPaid,
+      });
+      return order;
+    } finally {
+      this.cancelling.delete(orderId);
+    }
+  }
