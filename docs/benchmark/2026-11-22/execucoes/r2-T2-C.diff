diff --git a/test/cancelOrder.test.js b/test/cancelOrder.test.js
new file mode 100644
index 0000000..8e50d65
--- /dev/null
+++ b/test/cancelOrder.test.js
@@ -0,0 +1,169 @@
+import assert from 'node:assert/strict';
+import { describe, it } from 'node:test';
+
+import { FakePaymentGateway } from '../src/index.js';
+import { formatReport, salesReport } from '../src/reports/salesReport.js';
+import { CUSTOMER, testStore } from './helpers.js';
+
+class RefusingGateway extends FakePaymentGateway {
+  async refund(args) {
+    this.refunds.push(args);
+    return { ok: false, reason: 'refund_blocked' };
+  }
+}
+
+async function pendingOrder(store, sku = 'TEC-040', quantity = 2) {
+  return store.orders.placeOrder({ customer: CUSTOMER, items: [{ sku, quantity }] });
+}
+
+async function paidOrder(store, sku = 'TEC-040', quantity = 2) {
+  const order = await pendingOrder(store, sku, quantity);
+  await store.orders.payOrder(order.id, 'pix');
+  return order;
+}
+
+describe('OrderService#cancelOrder', () => {
+  it('exige motivo, antes de qualquer efeito', async () => {
+    const store = testStore();
+    const order = await paidOrder(store);
+    for (const reason of [undefined, '', '   ', 42]) {
+      await assert.rejects(store.orders.cancelOrder(order.id, reason), { code: 'VALIDATION_ERROR' });
+    }
+    assert.equal(order.status, 'paid');
+    assert.equal(store.gateway.refunds.length, 0);
+  });
+
+  it('pedido inexistente', async () => {
+    const store = testStore();
+    await assert.rejects(store.orders.cancelOrder('ORD-9999', 'x'), { code: 'ORDER_NOT_FOUND' });
+  });
+
+  it('cancela pendente: libera a reserva, sem estorno', async () => {
+    const store = testStore();
+    const order = await pendingOrder(store);
+    assert.equal(store.inventory.available('TEC-040'), 6);
+    const result = await store.orders.cancelOrder(order.id, '  desisti  ');
+    assert.equal(result, order);
+    assert.equal(order.status, 'cancelled');
+    assert.equal(store.inventory.available('TEC-040'), 8);
+    assert.equal(store.inventory.onHand('TEC-040'), 8);
+    assert.equal(store.gateway.refunds.length, 0);
+    assert.deepEqual(store.bus.emitted('order.cancelled')[0], {
+      orderId: order.id,
+      email: 'ana@example.com',
+      name: 'Ana Souza',
+      reason: 'desisti',
+      refunded: false,
+    });
+  });
+
+  it('cancela pago: estorna o total uma vez e devolve o estoque', async () => {
+    const store = testStore();
+    const order = await paidOrder(store);
+    assert.equal(store.inventory.onHand('TEC-040'), 6);
+    await store.orders.cancelOrder(order.id, 'arrependimento');
+    assert.equal(order.status, 'cancelled');
+    assert.equal(store.gateway.refunds.length, 1);
+    assert.equal(store.gateway.refunds[0].paymentId, order.payment.paymentId);
+    assert.equal(store.gateway.refunds[0].amount, order.totals.total);
+    assert.equal(store.inventory.onHand('TEC-040'), 8);
+    assert.equal(store.bus.emitted('order.cancelled')[0].refunded, true);
+  });
+
+  it('registra motivo, data e histórico', async () => {
+    const store = testStore();
+    const order = await pendingOrder(store);
+    assert.equal(order.cancelReason, null);
+    assert.equal(order.cancelledAt, null);
+    await store.orders.cancelOrder(order.id, 'sem ideia');
+    assert.equal(order.cancelReason, 'sem ideia');
+    assert.equal(order.cancelledAt, '2026-03-10T12:00:00.000Z');
+    assert.deepEqual(order.history.at(-1), { status: 'cancelled', at: '2026-03-10T12:00:00.000Z', reason: 'sem ideia' });
+    assert.equal(order.toJSON().cancelReason, 'sem ideia');
+    assert.equal(order.toJSON().cancelledAt, '2026-03-10T12:00:00.000Z');
+  });
+
+  it('estorno recusado: REFUND_FAILED, segue paid, estoque intacto, sem evento', async () => {
+    const gateway = new RefusingGateway();
+    const store = testStore({ gateway });
+    const order = await paidOrder(store);
+    await assert.rejects(store.orders.cancelOrder(order.id, 'x'), (error) => {
+      assert.equal(error.code, 'REFUND_FAILED');
+      assert.equal(error.details.reason, 'refund_blocked');
+      return true;
+    });
+    assert.equal(order.status, 'paid');
+    assert.equal(order.cancelReason, null);
+    assert.equal(store.inventory.onHand('TEC-040'), 6);
+    assert.equal(store.bus.emitted('order.cancelled').length, 0);
+    assert.equal(store.orders.cancelling.size, 0);
+  });
+
+  it('não cancela cancelado, enviado, entregue nem payment_failed', async () => {
+    const store = testStore();
+    const cancelled = await pendingOrder(store, 'CAN-010', 1);
+    await store.orders.cancelOrder(cancelled.id, 'x');
+    const shipped = await paidOrder(store, 'CAM-020', 1);
+    store.orders.shipOrder(shipped.id, 'br1');
+    const delivered = await paidOrder(store, 'CAM-020', 1);
+    store.orders.shipOrder(delivered.id, 'br2');
+    store.orders.deliverOrder(delivered.id);
+    const failedStore = testStore({
+      gateway: new FakePaymentGateway({ script: [{ ok: false, retryable: false, reason: 'card_declined' }] }),
+    });
+    const failed = await pendingOrder(failedStore, 'MOU-030', 1);
+    await failedStore.orders.payOrder(failed.id, 'credit_card');
+
+    for (const [svc, id] of [
+      [store, cancelled.id],
+      [store, shipped.id],
+      [store, delivered.id],
+      [failedStore, failed.id],
+    ]) {
+      await assert.rejects(svc.orders.cancelOrder(id, 'x'), { code: 'ORDER_NOT_CANCELLABLE' });
+    }
+    assert.equal(store.gateway.refunds.length, 0);
+  });
+
+  it('cancelamentos simultâneos estornam uma só vez', async () => {
+    const store = testStore();
+    const order = await paidOrder(store);
+    const results = await Promise.allSettled([
+      store.orders.cancelOrder(order.id, 'a'),
+      store.orders.cancelOrder(order.id, 'b'),
+    ]);
+    assert.deepEqual(results.map((r) => r.status).sort(), ['fulfilled', 'rejected']);
+    const rejected = results.find((r) => r.status === 'rejected');
+    assert.equal(rejected.reason.code, 'ORDER_NOT_CANCELLABLE');
+    assert.equal(store.gateway.refunds.length, 1);
+    assert.equal(store.inventory.onHand('TEC-040'), 8);
+    assert.equal(store.bus.emitted('order.cancelled').length, 1);
+  });
+
+  it('envia a mensagem ao cliente', async () => {
+    const store = testStore();
+    const order = await paidOrder(store);
+    await store.orders.cancelOrder(order.id, 'arrependimento');
+    const message = store.transport.sent.at(-1);
+    assert.equal(message.subject, `Pedido ${order.id} cancelado`);
+    assert.equal(message.to, 'ana@example.com');
+    assert.ok(message.body.startsWith('Olá, Ana Souza.'));
+    assert.ok(message.body.includes('estornado'));
+
+    const pending = await pendingOrder(store, 'CAN-010', 1);
+    await store.orders.cancelOrder(pending.id, 'x');
+    assert.ok(!store.transport.sent.at(-1).body.includes('estornado'));
+  });
+
+  it('o relatório de vendas ignora cancelados', async () => {
+    const store = testStore();
+    const a = await paidOrder(store, 'LIV-001', 1);
+    const b = await paidOrder(store, 'LIV-001', 1);
+    await store.orders.cancelOrder(b.id, 'x');
+    const report = salesReport(store.orders.listOrders());
+    assert.equal(report.orderCount, 1);
+    assert.equal(report.revenue, a.totals.total);
+    assert.equal(report.bySku['LIV-001'].quantity, 1);
+    assert.ok(formatReport(report).includes('Pedidos: 1'));
+  });
+});
