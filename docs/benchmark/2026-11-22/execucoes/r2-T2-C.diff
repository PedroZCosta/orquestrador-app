+
+  /**
+   * Cancela um pedido `pending` (libera a reserva) ou `paid` (estorna o total e
+   * devolve os itens ao estoque). Se o estorno for recusado, o pedido segue
+   * `paid`. Chamadas simultâneas no mesmo pedido: só a primeira prossegue.
+   */
+  async cancelOrder(orderId, reason) {
+    const why = requireString(reason, 'reason');
+    const order = this.repository.get(orderId);
+    this.assertCancellable(order);
+    this.cancelling.add(orderId);
+    try {
+      let refunded = false;
+      if (order.status === 'paid') {
+        const amount = order.totals.total;
+        const result = await this.payments.refund({ paymentId: order.payment.paymentId, amount });
+        if (!result.ok) {
+          throw new DomainError('REFUND_FAILED', `O estorno do pedido ${orderId} foi recusado: ${result.reason}.`, {
+            orderId,
+            reason: result.reason,
+          });
+        }
+        refunded = true;
+        this.assertCancellable(order, false);
+        for (const line of order.lines) {
+          this.inventory.addStock(line.sku, line.quantity);
+        }
+      } else {
+        this.inventory.release(orderId);
+      }
+      order.markCancelled(why, this.now().toISOString());
+      this.repository.save(order);
+      this.logger?.info('Pedido cancelado', { orderId, refunded });
+      this.bus.emit('order.cancelled', {
+        orderId,
+        email: order.customer.email,
+        name: order.customer.name,
+        reason: why,
+        refunded,
+      });
+      return order;
+    } finally {
+      this.cancelling.delete(orderId);
+    }
+  }
+
+  assertCancellable(order, checkInProgress = true) {
+    const busy = checkInProgress && this.cancelling.has(order.id);
+    if (busy || !['pending', 'paid'].includes(order.status)) {
+      throw new DomainError('ORDER_NOT_CANCELLABLE', `O pedido ${order.id} não pode ser cancelado (${order.status}).`, {
+        status: order.status,
+      });
+    }
+  }
 }
