+import assert from 'node:assert/strict';
+import { describe, it } from 'node:test';
+
+import { FakePaymentGateway, ORDER_STATUSES } from '../src/index.js';
+import { salesReport } from '../src/reports/salesReport.js';
+import { CUSTOMER, testStore } from './helpers.js';
+
+/** Gateway cuja resposta de `refund` fica presa até `releaseRefund()`. */
+class SlowRefundGateway extends FakePaymentGateway {
+  async refund(args) {
+    await new Promise((resolve) => {
+      this.releaseRefund = resolve;
+    });
+    return super.refund(args);
+  }
+}
+
+/** Gateway cuja resposta de `charge` fica presa até `releaseCharge()`. */
+class SlowChargeGateway extends FakePaymentGateway {
+  async charge(args) {
+    await new Promise((resolve) => {
+      this.releaseCharge = resolve;
+    });
+    return super.charge(args);
+  }
+}
+
+async function paidOrder(store, items = [{ sku: 'TEC-040', quantity: 2 }]) {
+  const order = await store.orders.placeOrder({ customer: CUSTOMER, items });
+  await store.orders.payOrder(order.id, 'credit_card');
+  return order;
+}
+
+describe('OrderService#cancelOrder', () => {
+  it('cancelled faz parte dos status', () => {
+    assert.ok(ORDER_STATUSES.includes('cancelled'));
+  });
+
+  it('pedido pendente: desfaz a reserva, sem estorno', async () => {
+    const store = testStore();
+    const order = await store.orders.placeOrder({ customer: CUSTOMER, items: [{ sku: 'LIV-001', quantity: 3 }] });
+    assert.equal(store.inventory.available('LIV-001'), 17);
+    store.clock.set('2026-03-11T09:30:00.000Z');
+
+    const result = await store.orders.cancelOrder(order.id, '  desisti da compra  ');
+
+    assert.equal(result, order);
+    assert.equal(order.status, 'cancelled');
+    assert.equal(order.cancelReason, 'desisti da compra');
+    assert.equal(order.cancelledAt, '2026-03-11T09:30:00.000Z');
+    assert.equal(order.updatedAt, '2026-03-11T09:30:00.000Z');
+    assert.deepEqual(order.history.at(-1), {
+      status: 'cancelled',
+      at: '2026-03-11T09:30:00.000Z',
+      reason: 'desisti da compra',
+    });
+    assert.equal(store.inventory.available('LIV-001'), 20);
+    assert.equal(store.inventory.onHand('LIV-001'), 20);
+    assert.equal(store.inventory.reservationOf(order.id), null);
+    assert.equal(store.gateway.refunds.length, 0);
+    assert.equal(order.payment, null);
+    assert.equal(store.orders.getOrder(order.id).status, 'cancelled');
+    assert.equal(order.toJSON().cancelReason, 'desisti da compra');
+    assert.equal(order.toJSON().cancelledAt, '2026-03-11T09:30:00.000Z');
+  });
+
+  it('pedido pago: estorna o total uma vez e devolve os itens ao estoque', async () => {
+    const store = testStore();
+    const order = await paidOrder(store);
+    assert.equal(store.inventory.onHand('TEC-040'), 6);
+
+    await store.orders.cancelOrder(order.id, 'produto com defeito');
+
+    assert.equal(order.status, 'cancelled');
+    assert.deepEqual(store.gateway.refunds, [{ paymentId: 'PAY-0001', amount: order.totals.total, refundId: 'REF-0001' }]);
+    assert.equal(order.payment.refundId, 'REF-0001');
+    assert.equal(order.payment.refundedAmount, order.totals.total);
+    assert.equal(store.inventory.onHand('TEC-040'), 8);
+    assert.equal(store.inventory.available('TEC-040'), 8);
+    assert.deepEqual(
+      order.history.map((entry) => entry.status),
+      ['pending', 'paid', 'cancelled'],
+    );
+
+    await assert.rejects(store.orders.cancelOrder(order.id, 'de novo'), { code: 'ORDER_NOT_CANCELLABLE' });
+    assert.equal(store.gateway.refunds.length, 1);
+    assert.equal(store.inventory.onHand('TEC-040'), 8);
+  });
+
+  it('estorno recusado: REFUND_FAILED, o pedido continua pago e o estoque fica igual', async () => {
+    const store = testStore();
+    const order = await paidOrder(store);
+    const original = store.gateway.refund.bind(store.gateway);
+    store.gateway.refund = async () => ({ ok: false, reason: 'refund_declined' });
+
+    await assert.rejects(store.orders.cancelOrder(order.id, 'arrependimento'), {
