+  /**
+   * Cancela um pedido `pending` (desfaz a reserva) ou `paid` (estorna o total
+   * pelo gateway e devolve os itens ao estoque). Estorno recusado: lança
+   * `REFUND_FAILED` e o pedido continua `paid`, com o estoque intacto.
+   */
+  async cancelOrder(orderId, reason) {
+    const order = this.repository.get(orderId);
+    const why = requireString(reason, 'reason');
+    const cancellable = order.status === 'pending' || order.status === 'paid';
+    if (!cancellable || this.busy.has(orderId)) {
+      throw new DomainError('ORDER_NOT_CANCELLABLE', `O pedido ${orderId} está ${order.status}.`, {
+        status: order.status,
+        busy: this.busy.has(orderId),
+      });
+    }
+
+    let refund = null;
+    if (order.status === 'paid') {
+      const { paymentId } = order.payment;
+      const amount = order.totals.total;
+      let result;
+      this.busy.add(orderId);
+      try {
+        result = await this.payments.refund({ orderId, paymentId, amount });
+      } finally {
+        this.busy.delete(orderId);
+      }
+      if (!result.ok) {
+        throw new DomainError('REFUND_FAILED', `O estorno do pedido ${orderId} foi recusado (${result.reason}).`, {
+          orderId,
+          paymentId,
+          reason: result.reason,
+        });
+      }
+      refund = { refundId: result.refundId, amount };
+    }
+
+    order.markCancelled(why, this.now().toISOString(), refund);
+    if (refund === null) {
+      this.inventory.release(orderId);
+    } else {
+      for (const line of order.lines) {
+        this.inventory.addStock(line.sku, line.quantity);
+      }
+    }
+    this.repository.save(order);
+    this.logger?.info('Pedido cancelado', { orderId, refunded: refund !== null });
+    this.bus.emit('order.cancelled', {
+      orderId,
+      email: order.customer.email,
+      name: order.customer.name,
+      reason: why,
+      refunded: refund !== null,
+    });
+    return order;
+  }
 }
