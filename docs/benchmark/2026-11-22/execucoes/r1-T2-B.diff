+
+  /**
+   * Cancela um pedido `pending` ou `paid`. Pendente: desfaz a reserva. Pago:
+   * estorna o total pelo gateway e devolve os itens ao estoque físico; se o
+   * estorno for recusado, lança `REFUND_FAILED` sem alterar pedido nem estoque.
+   */
+  async cancelOrder(orderId, reason) {
+    const cleanReason = requireString(reason, 'reason');
+    const order = this.repository.get(orderId);
+    if (!['pending', 'paid'].includes(order.status) || this.inFlight.has(orderId)) {
+      throw new DomainError('ORDER_NOT_CANCELLABLE', `O pedido ${orderId} não pode ser cancelado (${order.status}).`, {
+        status: order.status,
+      });
+    }
+
+    let refund = null;
+    if (order.status === 'paid') {
+      this.inFlight.add(orderId);
+      try {
+        const result = await this.payments.refund({
+          paymentId: order.payment.paymentId,
+          amount: order.totals.total,
+        });
+        if (!result.ok) {
+          throw new DomainError('REFUND_FAILED', `O estorno do pedido ${orderId} foi recusado (${result.reason}).`, {
+            orderId,
+            reason: result.reason,
+          });
+        }
+        refund = { refundId: result.refundId, amount: order.totals.total };
+      } finally {
+        this.inFlight.delete(orderId);
+      }
+      for (const line of order.lines) {
+        this.inventory.addStock(line.sku, line.quantity);
+      }
+    } else {
+      this.inventory.release(orderId);
+    }
+
+    order.markCancelled({ reason: cleanReason, refund }, this.now().toISOString());
+    this.repository.save(order);
+    this.logger?.info('Pedido cancelado', { orderId, refunded: refund !== null });
+    this.bus.emit('order.cancelled', {
+      orderId,
+      email: order.customer.email,
+      name: order.customer.name,
+      reason: cleanReason,
+      refunded: refund !== null,
+    });
+    return order;
+  }
 }
