+  async cancelOrder(orderId, reason) {
+    const why = requireString(reason, 'reason');
+    const order = this.repository.get(orderId);
+    if (this.cancelling.has(orderId) || !['pending', 'paid'].includes(order.status)) {
+      throw new DomainError('ORDER_NOT_CANCELLABLE', `O pedido ${orderId} está ${order.status}.`, {
+        status: order.status,
+      });
+    }
+    this.cancelling.add(orderId);
+    try {
+      const refunded = order.status === 'paid';
+      if (refunded) {
+        const result = await this.payments.refund({
+          paymentId: order.payment.paymentId,
+          amount: order.totals.total,
+        });
+        if (!result.ok) {
+          throw new DomainError('REFUND_FAILED', `Não foi possível estornar o pedido ${orderId}.`, {
+            reason: result.reason,
+          });
+        }
+        for (const line of order.lines) {
+          this.inventory.addStock(line.sku, line.quantity);
+        }
+      } else {
+        this.inventory.release(orderId);
+      }
+      order.markCancelled(why, this.now().toISOString());
+      this.repository.save(order);
+      this.logger?.info('Pedido cancelado', { orderId, refunded });
+      this.bus.emit('order.cancelled', {
+        orderId,
+        email: order.customer.email,
+        name: order.customer.name,
+        reason: why,
+        refunded,
+      });
+      return order;
+    } finally {
+      this.cancelling.delete(orderId);
+    }
+  }
+
