diff --git a/test/cancelOrder.test.js b/test/cancelOrder.test.js
new file mode 100644
index 0000000..aaf78f5
--- /dev/null
+++ b/test/cancelOrder.test.js
@@ -0,0 +1,170 @@
+import assert from 'node:assert/strict';
+import { describe, it } from 'node:test';
+
+import { FakePaymentGateway, salesReport } from '../src/index.js';
+import { CUSTOMER, testStore } from './helpers.js';
+
+const ITEMS = [{ sku: 'LIV-001', quantity: 2 }];
+
+async function placed(store) {
+  return store.orders.placeOrder({ customer: CUSTOMER, items: ITEMS });
+}
+
+async function paid(store) {
+  const order = await placed(store);
+  await store.orders.payOrder(order.id, 'pix');
+  return order;
+}
+
+async function rejects(promise, code) {
+  await assert.rejects(promise, (error) => error.code === code);
+}
+
+describe('OrderService#cancelOrder', () => {
+  it('cancela pedido pendente e libera a reserva, sem estorno', async () => {
+    const store = testStore();
+    const order = await placed(store);
+    const result = await store.orders.cancelOrder(order.id, '  desisti  ');
+    assert.equal(result.status, 'cancelled');
+    assert.equal(result.cancelReason, 'desisti');
+    assert.equal(result.cancelledAt, '2026-03-10T12:00:00.000Z');
+    assert.deepEqual(result.history.at(-1), { status: 'cancelled', at: '2026-03-10T12:00:00.000Z', reason: 'desisti' });
+    assert.equal(store.inventory.available('LIV-001'), 20);
+    assert.equal(store.inventory.reservationOf(order.id), null);
+    assert.equal(store.gateway.refunds.length, 0);
+    const [event] = store.bus.emitted('order.cancelled');
+    assert.deepEqual(event, {
+      orderId: order.id,
+      email: 'ana@example.com',
+      name: 'Ana Souza',
+      reason: 'desisti',
+      refunded: false,
+    });
+  });
+
+  it('inicia cancelReason e cancelledAt como null', async () => {
+    const order = await placed(testStore());
+    assert.equal(order.cancelReason, null);
+    assert.equal(order.cancelledAt, null);
+    assert.equal(order.toJSON().cancelledAt, null);
+  });
+
+  it('pedido pago: estorna o total uma vez e devolve o estoque', async () => {
+    const store = testStore();
+    const order = await paid(store);
+    assert.equal(store.inventory.onHand('LIV-001'), 18);
+    const result = await store.orders.cancelOrder(order.id, 'erro no pedido');
+    assert.equal(result.status, 'cancelled');
+    assert.equal(store.gateway.refunds.length, 1);
+    assert.equal(store.gateway.refunds[0].paymentId, order.payment.paymentId);
+    assert.equal(store.gateway.refunds[0].amount, order.totals.total);
+    assert.equal(store.inventory.onHand('LIV-001'), 20);
+    assert.equal(store.bus.emitted('order.cancelled')[0].refunded, true);
+  });
+
+  it('estorno recusado: REFUND_FAILED, segue pago, estoque intacto, sem evento', async () => {
+    const store = testStore();
+    const order = await paid(store);
+    store.gateway.refund = async () => ({ ok: false, reason: 'gateway_down' });
+    await assert.rejects(store.orders.cancelOrder(order.id, 'x'), (error) => {
+      assert.equal(error.code, 'REFUND_FAILED');
+      assert.deepEqual(error.details, { orderId: order.id, reason: 'gateway_down' });
+      return true;
+    });
+    assert.equal(store.orders.getOrder(order.id).status, 'paid');
+    assert.equal(store.inventory.onHand('LIV-001'), 18);
+    assert.equal(store.bus.emitted('order.cancelled').length, 0);
+  });
+
+  it('exceção do gateway propaga sem alterar pedido nem estoque', async () => {
+    const store = testStore();
+    const order = await paid(store);
+    store.gateway.refund = async () => {
+      throw new Error('falha de rede');
+    };
+    await assert.rejects(store.orders.cancelOrder(order.id, 'x'), /falha de rede/);
+    assert.equal(store.orders.getOrder(order.id).status, 'paid');
+    assert.equal(store.inventory.onHand('LIV-001'), 18);
+    assert.equal(store.bus.emitted('order.cancelled').length, 0);
+  });
+
+  it('motivo vazio, ausente ou só espaços dá VALIDATION_ERROR', async () => {
+    const store = testStore();
+    const order = await placed(store);
+    for (const reason of ['', '   ', undefined, null]) {
+      await rejects(store.orders.cancelOrder(order.id, reason), 'VALIDATION_ERROR');
+    }
+    assert.equal(store.orders.getOrder(order.id).status, 'pending');
+  });
+
+  it('pedido inexistente dá ORDER_NOT_FOUND', async () => {
+    await rejects(testStore().orders.cancelOrder('ORD-9999', 'x'), 'ORDER_NOT_FOUND');
+  });
+
+  it('status não cancelável dá ORDER_NOT_CANCELLABLE', async () => {
+    const store = testStore();
+    const cancelled = await placed(store);
+    await store.orders.cancelOrder(cancelled.id, 'x');
+    await assert.rejects(store.orders.cancelOrder(cancelled.id, 'x'), (error) => {
+      assert.equal(error.code, 'ORDER_NOT_CANCELLABLE');
+      assert.equal(error.details.status, 'cancelled');
+      return true;
+    });
+
+    const shipped = await paid(store);
+    store.orders.shipOrder(shipped.id, 'BR1');
+    await rejects(store.orders.cancelOrder(shipped.id, 'x'), 'ORDER_NOT_CANCELLABLE');
+
+    const delivered = await paid(store);
+    store.orders.shipOrder(delivered.id, 'BR2');
+    store.orders.deliverOrder(delivered.id);
+    await rejects(store.orders.cancelOrder(delivered.id, 'x'), 'ORDER_NOT_CANCELLABLE');
+
+    const failing = testStore({
+      gateway: new FakePaymentGateway({ script: [{ ok: false, retryable: false, reason: 'card_declined' }] }),
+    });
+    const failed = await placed(failing);
+    await failing.orders.payOrder(failed.id, 'credit_card');
+    await rejects(failing.orders.cancelOrder(failed.id, 'x'), 'ORDER_NOT_CANCELLABLE');
+  });
+
+  it('cancelamentos concorrentes estornam uma vez só', async () => {
+    const store = testStore();
+    const order = await paid(store);
+    const results = await Promise.allSettled([
+      store.orders.cancelOrder(order.id, 'a'),
+      store.orders.cancelOrder(order.id, 'b'),
+    ]);
+    assert.equal(results.filter((item) => item.status === 'fulfilled').length, 1);
+    const rejected = results.find((item) => item.status === 'rejected');
+    assert.equal(rejected.reason.code, 'ORDER_NOT_CANCELLABLE');
+    assert.equal(store.gateway.refunds.length, 1);
+    assert.equal(store.inventory.onHand('LIV-001'), 20);
+    assert.equal(store.orders.cancelling.size, 0);
+  });
+
+  it('avisa o cliente pelo notifier', async () => {
+    const store = testStore();
+    const order = await paid(store);
+    await store.orders.cancelOrder(order.id, 'erro no pedido');
+    const message = store.transport.sent.at(-1);
+    assert.equal(message.subject, 'Pedido ORD-0001 cancelado');
+    assert.ok(message.body.includes('Olá, Ana Souza!'));
+    assert.ok(message.body.includes('erro no pedido'));
+    assert.ok(message.body.includes('estornado'));
+
+    const pending = await placed(store);
+    await store.orders.cancelOrder(pending.id, 'desisti');
+    assert.ok(store.transport.sent.at(-1).body.includes('Não houve cobrança'));
+  });
+
+  it('salesReport ignora pedidos cancelados', async () => {
+    const store = testStore();
+    const a = await paid(store);
+    const b = await paid(store);
+    await store.orders.cancelOrder(b.id, 'x');
+    const report = salesReport(store.orders.listOrders());
+    assert.equal(report.orderCount, 1);
+    assert.equal(report.revenue, a.totals.total);
+  });
+});
