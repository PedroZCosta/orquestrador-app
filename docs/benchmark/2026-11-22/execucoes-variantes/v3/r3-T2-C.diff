diff --git a/test/cancelOrder.test.js b/test/cancelOrder.test.js
new file mode 100644
index 0000000..2fc1f0b
--- /dev/null
+++ b/test/cancelOrder.test.js
@@ -0,0 +1,117 @@
+import assert from 'node:assert/strict';
+import { describe, it } from 'node:test';
+
+import { salesReport } from '../src/reports/salesReport.js';
+import { CUSTOMER, testStore } from './helpers.js';
+
+async function pendingOrder(store, quantity = 2) {
+  return store.orders.placeOrder({ customer: CUSTOMER, items: [{ sku: 'TEC-040', quantity }] });
+}
+
+async function paidOrder(store, quantity = 2) {
+  const order = await pendingOrder(store, quantity);
+  await store.orders.payOrder(order.id, 'pix');
+  return order;
+}
+
+describe('OrderService#cancelOrder', () => {
+  it('pendente: libera a reserva, sem estorno', async () => {
+    const store = testStore();
+    const order = await pendingOrder(store);
+    const before = store.inventory.available('TEC-040');
+    const result = await store.orders.cancelOrder(order.id, '  desisti  ');
+    assert.equal(result, order);
+    assert.equal(order.status, 'cancelled');
+    assert.equal(store.inventory.available('TEC-040'), before + 2);
+    assert.equal(store.inventory.onHand('TEC-040'), 8);
+    assert.equal(store.gateway.refunds.length, 0);
+  });
+
+  it('pago: estorna uma vez com paymentId e total e devolve ao estoque', async () => {
+    const store = testStore();
+    const order = await paidOrder(store);
+    assert.equal(store.inventory.onHand('TEC-040'), 6);
+    await store.orders.cancelOrder(order.id, 'defeito');
+    assert.equal(order.status, 'cancelled');
+    assert.equal(store.gateway.refunds.length, 1);
+    assert.equal(store.gateway.refunds[0].paymentId, order.payment.paymentId);
+    assert.equal(store.gateway.refunds[0].amount, order.totals.total);
+    assert.equal(store.inventory.onHand('TEC-040'), 8);
+    assert.equal(store.inventory.available('TEC-040'), 8);
+  });
+
+  it('estorno recusado: REFUND_FAILED, continua pago e estoque intacto', async () => {
+    const store = testStore();
+    const order = await paidOrder(store);
+    store.gateway.refund = async () => ({ ok: false, reason: 'gateway_down' });
+    await assert.rejects(store.orders.cancelOrder(order.id, 'defeito'), { code: 'REFUND_FAILED' });
+    assert.equal(order.status, 'paid');
+    assert.equal(order.cancelledAt, null);
+    assert.equal(store.inventory.onHand('TEC-040'), 6);
+    assert.equal(store.bus.emitted('order.cancelled').length, 0);
+  });
+
+  it('dois cancelamentos simultâneos estornam uma vez só', async () => {
+    const store = testStore();
+    const order = await paidOrder(store);
+    const results = await Promise.allSettled([
+      store.orders.cancelOrder(order.id, 'a'),
+      store.orders.cancelOrder(order.id, 'b'),
+    ]);
+    assert.deepEqual(results.map((r) => r.status).sort(), ['fulfilled', 'rejected']);
+    assert.equal(results.find((r) => r.status === 'rejected').reason.code, 'ORDER_NOT_CANCELLABLE');
+    assert.equal(store.gateway.refunds.length, 1);
+    assert.equal(store.inventory.onHand('TEC-040'), 8);
+  });
+
+  it('reason vazio ou ausente', async () => {
+    const store = testStore();
+    const order = await pendingOrder(store);
+    for (const reason of [undefined, '', '   ', 5]) {
+      await assert.rejects(store.orders.cancelOrder(order.id, reason), { code: 'VALIDATION_ERROR' });
+    }
+    assert.equal(order.status, 'pending');
+  });
+
+  it('pedido inexistente', async () => {
+    const store = testStore();
+    await assert.rejects(store.orders.cancelOrder('ORD-9999', 'x'), { code: 'ORDER_NOT_FOUND' });
+  });
+
+  it('status não cancelável, inclusive já cancelado (sem novo estorno)', async () => {
+    const store = testStore();
+    const shipped = await paidOrder(store, 1);
+    store.orders.shipOrder(shipped.id, 'br1');
+    await assert.rejects(store.orders.cancelOrder(shipped.id, 'x'), { code: 'ORDER_NOT_CANCELLABLE' });
+
+    const paid = await paidOrder(store, 1);
+    await store.orders.cancelOrder(paid.id, 'x');
+    await assert.rejects(store.orders.cancelOrder(paid.id, 'y'), { code: 'ORDER_NOT_CANCELLABLE' });
+    assert.equal(store.gateway.refunds.length, 1);
+  });
+
+  it('evento, notificação, histórico, cancelReason e cancelledAt', async () => {
+    const store = testStore();
+    const order = await paidOrder(store);
+    await store.orders.cancelOrder(order.id, 'defeito');
+    assert.deepEqual(store.bus.emitted('order.cancelled'), [
+      { orderId: order.id, email: 'ana@example.com', name: 'Ana Souza', reason: 'defeito', refunded: true },
+    ]);
+    const message = store.transport.sent.find((m) => m.type === 'order.cancelled');
+    assert.equal(message.subject, `Pedido ${order.id} cancelado`);
+    assert.equal(message.to, 'ana@example.com');
+    assert.equal(order.cancelReason, 'defeito');
+    assert.equal(order.cancelledAt, '2026-03-10T12:00:00.000Z');
+    assert.deepEqual(order.history.at(-1), { status: 'cancelled', at: order.cancelledAt, reason: 'defeito' });
+  });
+
+  it('salesReport ignora pedidos cancelados', async () => {
+    const store = testStore();
+    const kept = await paidOrder(store, 1);
+    const cancelled = await pendingOrder(store, 1);
+    await store.orders.cancelOrder(cancelled.id, 'x');
+    const report = salesReport(store.orders.listOrders());
+    assert.equal(report.orderCount, 1);
+    assert.equal(report.revenue, kept.totals.total);
+  });
+});
