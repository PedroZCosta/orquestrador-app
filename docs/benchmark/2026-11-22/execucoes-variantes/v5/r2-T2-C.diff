diff --git a/test/cancelOrder.test.js b/test/cancelOrder.test.js
new file mode 100644
index 0000000..d5df8c3
--- /dev/null
+++ b/test/cancelOrder.test.js
@@ -0,0 +1,125 @@
+import assert from 'node:assert/strict';
+import { describe, it } from 'node:test';
+
+import { FakePaymentGateway, ORDER_STATUSES, salesReport } from '../src/index.js';
+import { CUSTOMER, testStore } from './helpers.js';
+
+const place = (store, sku = 'LIV-001', quantity = 2) =>
+  store.orders.placeOrder({ customer: CUSTOMER, items: [{ sku, quantity }] });
+
+describe('OrderService#cancelOrder', () => {
+  it('registra o status cancelled', () => {
+    assert.ok(ORDER_STATUSES.includes('cancelled'));
+  });
+
+  it('valida o motivo e a existência do pedido', async () => {
+    const store = testStore();
+    const order = await place(store);
+    for (const bad of [undefined, '', '   ', 5]) {
+      await assert.rejects(store.orders.cancelOrder(order.id, bad), { code: 'VALIDATION_ERROR' });
+    }
+    assert.equal(order.status, 'pending');
+    await assert.rejects(store.orders.cancelOrder('ORD-9999', 'x'), { code: 'ORDER_NOT_FOUND' });
+  });
+
+  it('pending: desfaz a reserva, sem estorno', async () => {
+    const store = testStore();
+    const order = await place(store);
+    const result = await store.orders.cancelOrder(order.id, 'desisti');
+    assert.equal(result, order);
+    assert.equal(order.status, 'cancelled');
+    assert.equal(order.cancelReason, 'desisti');
+    assert.equal(order.cancelledAt, '2026-03-10T12:00:00.000Z');
+    assert.deepEqual(order.history.at(-1), { status: 'cancelled', at: '2026-03-10T12:00:00.000Z', reason: 'desisti' });
+    assert.equal(store.inventory.available('LIV-001'), 20);
+    assert.equal(store.inventory.reservationOf(order.id), null);
+    assert.equal(store.gateway.refunds.length, 0);
+    const [event] = store.bus.emitted('order.cancelled');
+    assert.deepEqual(event, {
+      orderId: order.id, email: 'ana@example.com', name: 'Ana Souza', reason: 'desisti', refunded: false,
+    });
+  });
+
+  it('paid: estorna o total uma vez e devolve ao estoque físico', async () => {
+    const store = testStore();
+    const order = await place(store);
+    await store.orders.payOrder(order.id, 'pix');
+    assert.equal(store.inventory.onHand('LIV-001'), 18);
+    await store.orders.cancelOrder(order.id, '  erro  ');
+    assert.equal(order.status, 'cancelled');
+    assert.equal(order.cancelReason, 'erro');
+    assert.equal(store.gateway.refunds.length, 1);
+    assert.equal(store.gateway.refunds[0].paymentId, order.payment.paymentId);
+    assert.equal(store.gateway.refunds[0].amount, order.totals.total);
+    assert.equal(store.inventory.onHand('LIV-001'), 20);
+    assert.equal(store.inventory.available('LIV-001'), 20);
+    assert.equal(store.bus.emitted('order.cancelled')[0].refunded, true);
+  });
+
+  it('recusa do gateway: REFUND_FAILED, segue paid e estoque intacto', async () => {
+    const gateway = new FakePaymentGateway();
+    gateway.refund = async () => ({ ok: false, reason: 'gateway_down' });
+    const store = testStore({ gateway });
+    const order = await place(store);
+    await store.orders.payOrder(order.id, 'pix');
+    await assert.rejects(store.orders.cancelOrder(order.id, 'x'), { code: 'REFUND_FAILED' });
+    assert.equal(order.status, 'paid');
+    assert.equal(order.cancelReason, null);
+    assert.equal(store.inventory.onHand('LIV-001'), 18);
+    assert.equal(store.bus.emitted('order.cancelled').length, 0);
+  });
+
+  it('outros status e cancelamento repetido: ORDER_NOT_CANCELLABLE', async () => {
+    const store = testStore();
+    const shipped = await place(store, 'CAM-020', 1);
+    await store.orders.payOrder(shipped.id, 'pix');
+    store.orders.shipOrder(shipped.id, 'br1');
+    await assert.rejects(store.orders.cancelOrder(shipped.id, 'x'), { code: 'ORDER_NOT_CANCELLABLE' });
+    store.orders.deliverOrder(shipped.id);
+    await assert.rejects(store.orders.cancelOrder(shipped.id, 'x'), { code: 'ORDER_NOT_CANCELLABLE' });
+
+    const failed = new FakePaymentGateway({ script: [{ ok: false, retryable: false, reason: 'card_declined' }] });
+    const s2 = testStore({ gateway: failed });
+    const o2 = await place(s2);
+    await s2.orders.payOrder(o2.id, 'pix');
+    await assert.rejects(s2.orders.cancelOrder(o2.id, 'x'), { code: 'ORDER_NOT_CANCELLABLE' });
+
+    const o3 = await place(store);
+    await store.orders.cancelOrder(o3.id, 'x');
+    await assert.rejects(store.orders.cancelOrder(o3.id, 'y'), { code: 'ORDER_NOT_CANCELLABLE' });
+  });
+
+  it('cancelamentos concorrentes estornam uma só vez', async () => {
+    const store = testStore();
+    const order = await place(store);
+    await store.orders.payOrder(order.id, 'pix');
+    const results = await Promise.allSettled([
+      store.orders.cancelOrder(order.id, 'a'),
+      store.orders.cancelOrder(order.id, 'b'),
+    ]);
+    assert.deepEqual(results.map((r) => r.status).sort(), ['fulfilled', 'rejected']);
+    assert.equal(store.gateway.refunds.length, 1);
+    assert.equal(store.inventory.onHand('LIV-001'), 20);
+  });
+
+  it('envia a mensagem ao cliente', async () => {
+    const store = testStore();
+    const order = await place(store);
+    await store.orders.cancelOrder(order.id, 'desisti');
+    const message = store.transport.sent.find((m) => m.type === 'order.cancelled');
+    assert.equal(message.to, 'ana@example.com');
+    assert.equal(message.subject, `Pedido ${order.id} cancelado`);
+    assert.match(message.body, /^Olá, Ana Souza\./);
+    assert.match(message.body, /Dúvidas: /);
+  });
+
+  it('salesReport ignora cancelados', async () => {
+    const store = testStore();
+    const a = await place(store);
+    const b = await place(store, 'CAN-010', 1);
+    await store.orders.cancelOrder(a.id, 'x');
+    const report = salesReport(store.orders.listOrders());
+    assert.equal(report.orderCount, 1);
+    assert.equal(report.revenue, b.totals.total);
+  });
+});
