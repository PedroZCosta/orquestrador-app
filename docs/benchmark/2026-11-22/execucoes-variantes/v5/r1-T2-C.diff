diff --git a/test/cancelOrder.test.js b/test/cancelOrder.test.js
new file mode 100644
index 0000000..72cecd6
--- /dev/null
+++ b/test/cancelOrder.test.js
@@ -0,0 +1,139 @@
+import assert from 'node:assert/strict';
+import { describe, it } from 'node:test';
+
+import { ORDER_STATUSES } from '../src/orders/order.js';
+import { salesReport } from '../src/reports/salesReport.js';
+import { CUSTOMER, testStore } from './helpers.js';
+
+async function place(store, sku = 'TEC-040', quantity = 2) {
+  return store.orders.placeOrder({ customer: CUSTOMER, items: [{ sku, quantity }] });
+}
+
+describe('OrderService#cancelOrder', () => {
+  it('cancelled é um status conhecido', () => {
+    assert.ok(ORDER_STATUSES.includes('cancelled'));
+  });
+
+  it('exige motivo e pedido existente', async () => {
+    const store = testStore();
+    const order = await place(store);
+    for (const reason of [undefined, '', '   ', 42]) {
+      await assert.rejects(store.orders.cancelOrder(order.id, reason), { code: 'VALIDATION_ERROR' });
+    }
+    assert.equal(order.status, 'pending');
+    await assert.rejects(store.orders.cancelOrder('ORD-9999', 'x'), { code: 'ORDER_NOT_FOUND' });
+  });
+
+  it('pendente: desfaz a reserva, sem estorno, e registra motivo, data e histórico', async () => {
+    const store = testStore();
+    const order = await place(store);
+    const before = store.inventory.onHand('TEC-040');
+    const result = await store.orders.cancelOrder(order.id, 'desisti');
+    assert.equal(result, order);
+    assert.equal(order.status, 'cancelled');
+    assert.equal(order.cancelReason, 'desisti');
+    assert.equal(order.cancelledAt, '2026-03-10T12:00:00.000Z');
+    assert.deepEqual(
+      order.history.map((entry) => entry.status),
+      ['pending', 'cancelled'],
+    );
+    assert.equal(store.inventory.available('TEC-040'), before);
+    assert.equal(store.inventory.onHand('TEC-040'), before);
+    assert.equal(store.inventory.reservationOf(order.id), null);
+    assert.equal(store.gateway.refunds.length, 0);
+    assert.deepEqual(store.bus.emitted('order.cancelled')[0], {
+      orderId: order.id,
+      email: 'ana@example.com',
+      name: 'Ana Souza',
+      reason: 'desisti',
+      refunded: false,
+    });
+  });
+
+  it('pago: estorna o total uma vez e devolve os itens ao estoque físico', async () => {
+    const store = testStore();
+    const start = store.inventory.onHand('TEC-040');
+    const order = await place(store);
+    await store.orders.payOrder(order.id, 'pix');
+    assert.equal(store.inventory.onHand('TEC-040'), start - 2);
+    await store.orders.cancelOrder(order.id, 'defeito');
+    assert.equal(order.status, 'cancelled');
+    assert.equal(store.inventory.onHand('TEC-040'), start);
+    assert.equal(store.inventory.available('TEC-040'), start);
+    assert.deepEqual(
+      store.gateway.refunds.map(({ paymentId, amount }) => ({ paymentId, amount })),
+      [{ paymentId: order.payment.paymentId, amount: order.totals.total }],
+    );
+    assert.equal(store.bus.emitted('order.cancelled')[0].refunded, true);
+    await assert.rejects(store.orders.cancelOrder(order.id, 'de novo'), { code: 'ORDER_NOT_CANCELLABLE' });
+    assert.equal(store.gateway.refunds.length, 1);
+  });
+
+  it('cancelamentos simultâneos estornam uma única vez', async () => {
+    const store = testStore();
+    const order = await place(store);
+    await store.orders.payOrder(order.id, 'pix');
+    const results = await Promise.allSettled([
+      store.orders.cancelOrder(order.id, 'a'),
+      store.orders.cancelOrder(order.id, 'b'),
+    ]);
+    assert.deepEqual(results.map((r) => r.status).sort(), ['fulfilled', 'rejected']);
+    assert.equal(store.gateway.refunds.length, 1);
+  });
+
+  it('estorno recusado: REFUND_FAILED, pedido segue paid e estoque intocado', async () => {
+    const store = testStore();
+    const order = await place(store);
+    await store.orders.payOrder(order.id, 'pix');
+    const onHand = store.inventory.onHand('TEC-040');
+    store.gateway.refund = async () => ({ ok: false, reason: 'gateway_down' });
+    await assert.rejects(store.orders.cancelOrder(order.id, 'defeito'), { code: 'REFUND_FAILED' });
+    assert.equal(order.status, 'paid');
+    assert.equal(order.cancelReason, null);
+    assert.equal(store.inventory.onHand('TEC-040'), onHand);
+    assert.equal(store.bus.emitted('order.cancelled').length, 0);
+    assert.deepEqual(
+      order.history.map((entry) => entry.status),
+      ['pending', 'paid'],
+    );
+  });
+
+  it('não cancela pedido enviado, entregue, recusado ou já cancelado', async () => {
+    const store = testStore();
+    const shipped = await place(store, 'CAM-020', 1);
+    await store.orders.payOrder(shipped.id, 'pix');
+    store.orders.shipOrder(shipped.id, 'br1');
+    await assert.rejects(store.orders.cancelOrder(shipped.id, 'x'), { code: 'ORDER_NOT_CANCELLABLE' });
+    store.orders.deliverOrder(shipped.id);
+    await assert.rejects(store.orders.cancelOrder(shipped.id, 'x'), { code: 'ORDER_NOT_CANCELLABLE' });
+
+    const cancelled = await place(store, 'CAM-020', 1);
+    await store.orders.cancelOrder(cancelled.id, 'x');
+    await assert.rejects(store.orders.cancelOrder(cancelled.id, 'x'), { code: 'ORDER_NOT_CANCELLABLE' });
+
+    const failed = await place(store, 'MOU-030', 1);
+    failed.markPaymentFailed({ reason: 'card_declined', attempts: 1 }, '2026-03-10T12:00:00.000Z');
+    await assert.rejects(store.orders.cancelOrder(failed.id, 'x'), { code: 'ORDER_NOT_CANCELLABLE' });
+  });
+
+  it('avisa o cliente com o assunto do cancelamento', async () => {
+    const store = testStore();
+    const order = await place(store);
+    await store.orders.cancelOrder(order.id, 'desisti');
+    const message = store.transport.sent.at(-1);
+    assert.equal(message.subject, `Pedido ${order.id} cancelado`);
+    assert.equal(message.to, 'ana@example.com');
+    assert.ok(message.body.includes('desisti'));
+  });
+
+  it('salesReport não conta pedidos cancelados', async () => {
+    const store = testStore();
+    const a = await place(store, 'LIV-001', 1);
+    const b = await place(store, 'LIV-001', 1);
+    await store.orders.payOrder(a.id, 'pix');
+    await store.orders.cancelOrder(b.id, 'x');
+    const report = salesReport(store.orders.listOrders());
+    assert.equal(report.orderCount, 1);
+    assert.equal(report.revenue, a.totals.total);
+  });
+});
