diff --git a/test/cancelOrder.test.js b/test/cancelOrder.test.js
new file mode 100644
index 0000000..69c3cce
--- /dev/null
+++ b/test/cancelOrder.test.js
@@ -0,0 +1,137 @@
+import assert from 'node:assert/strict';
+import { describe, it } from 'node:test';
+
+import { FakePaymentGateway } from '../src/index.js';
+import { CUSTOMER, testStore } from './helpers.js';
+
+const AT = '2026-03-10T12:00:00.000Z';
+
+async function place(store, quantity = 2) {
+  return store.orders.placeOrder({ customer: CUSTOMER, items: [{ sku: 'LIV-001', quantity }] });
+}
+
+function capture(store) {
+  const events = [];
+  store.bus.on('order.cancelled', (payload) => events.push(payload));
+  return events;
+}
+
+describe('cancelOrder', () => {
+  it('cancela pedido pendente: libera a reserva, sem estorno', async () => {
+    const store = testStore();
+    const events = capture(store);
+    const order = await place(store);
+    const availableBefore = store.inventory.available('LIV-001');
+    const cancelled = await store.orders.cancelOrder(order.id, 'desisti');
+    assert.equal(cancelled.status, 'cancelled');
+    assert.equal(store.inventory.reservationOf(order.id), null);
+    assert.equal(store.inventory.available('LIV-001'), availableBefore + 2);
+    assert.equal(store.gateway.refunds.length, 0);
+    assert.deepEqual(events, [
+      { orderId: order.id, email: CUSTOMER.email, name: CUSTOMER.name, reason: 'desisti', refunded: false },
+    ]);
+    const message = store.transport.sent.at(-1);
+    assert.equal(message.subject, `Pedido ${order.id} cancelado`);
+    assert.ok(message.body.includes('desisti'));
+    assert.ok(!message.body.includes('estornado'));
+  });
+
+  it('cancela pedido pago: estorna o total, restaura o estoque físico', async () => {
+    const store = testStore();
+    const events = capture(store);
+    const order = await place(store);
+    await store.orders.payOrder(order.id, 'pix');
+    const onHandPaid = store.inventory.onHand('LIV-001');
+    const cancelled = await store.orders.cancelOrder(order.id, 'defeito');
+    assert.equal(store.gateway.refunds.length, 1);
+    assert.equal(store.gateway.refunds[0].paymentId, order.payment.paymentId);
+    assert.equal(store.gateway.refunds[0].amount, order.totals.total);
+    assert.equal(store.inventory.onHand('LIV-001'), onHandPaid + 2);
+    assert.equal(cancelled.status, 'cancelled');
+    assert.equal(cancelled.cancelReason, 'defeito');
+    assert.equal(cancelled.cancelledAt, AT);
+    assert.deepEqual(cancelled.history.at(-1), { status: 'cancelled', at: AT, reason: 'defeito' });
+    assert.equal(cancelled.toJSON().cancelledAt, AT);
+    assert.equal(store.orders.getOrder(order.id).status, 'cancelled');
+    assert.equal(events.length, 1);
+    assert.equal(events[0].refunded, true);
+    assert.ok(store.transport.sent.at(-1).body.includes('estornado'));
+  });
+
+  it('REFUND_FAILED: pedido segue pago, estoque intacto, sem evento; permite nova tentativa', async () => {
+    const gateway = new FakePaymentGateway();
+    const store = testStore({ gateway });
+    const events = capture(store);
+    const order = await place(store);
+    await store.orders.payOrder(order.id, 'pix');
+    const onHand = store.inventory.onHand('LIV-001');
+    const sent = store.transport.sent.length;
+    const realRefund = gateway.refund.bind(gateway);
+    gateway.refund = async () => ({ ok: false, reason: 'gateway_down' });
+    await assert.rejects(store.orders.cancelOrder(order.id, 'x'), (error) => {
+      assert.equal(error.code, 'REFUND_FAILED');
+      assert.equal(error.details.orderId, order.id);
+      assert.equal(error.details.reason, 'gateway_down');
+      return true;
+    });
+    assert.equal(store.orders.getOrder(order.id).status, 'paid');
+    assert.equal(store.orders.getOrder(order.id).cancelReason, null);
+    assert.equal(store.inventory.onHand('LIV-001'), onHand);
+    assert.equal(events.length, 0);
+    assert.equal(store.transport.sent.length, sent);
+    gateway.refund = realRefund;
+    const retry = await store.orders.cancelOrder(order.id, 'x');
+    assert.equal(retry.status, 'cancelled');
+  });
+
+  it('valida o motivo antes de buscar o pedido', async () => {
+    const store = testStore();
+    const order = await place(store);
+    for (const reason of ['', '   ', undefined]) {
+      await assert.rejects(store.orders.cancelOrder(order.id, reason), { code: 'VALIDATION_ERROR' });
+      await assert.rejects(store.orders.cancelOrder('ORD-9999', reason), { code: 'VALIDATION_ERROR' });
+    }
+    assert.equal(store.orders.getOrder(order.id).status, 'pending');
+  });
+
+  it('pedido inexistente', async () => {
+    const store = testStore();
+    await assert.rejects(store.orders.cancelOrder('ORD-9999', 'x'), { code: 'ORDER_NOT_FOUND' });
+  });
+
+  it('status não cancelável', async () => {
+    const gateway = new FakePaymentGateway({ script: [{ ok: true }, { ok: false, retryable: false, reason: 'card_declined' }, { ok: true }] });
+    const store = testStore({ gateway });
+    const shipped = await place(store, 1);
+    await store.orders.payOrder(shipped.id, 'pix');
+    store.orders.shipOrder(shipped.id, 'BR1');
+    const failed = await place(store, 1);
+    await store.orders.payOrder(failed.id, 'pix');
+    const pending = await place(store, 1);
+    await store.orders.cancelOrder(pending.id, 'a');
+
+    for (const [id, status] of [[shipped.id, 'shipped'], [failed.id, 'payment_failed'], [pending.id, 'cancelled']]) {
+      await assert.rejects(store.orders.cancelOrder(id, 'x'), (error) => {
+        assert.equal(error.code, 'ORDER_NOT_CANCELLABLE');
+        assert.equal(error.details.status, status);
+        return true;
+      });
+    }
+    assert.equal(store.gateway.refunds.length, 0);
+  });
+
+  it('cancelamento concorrente estorna uma única vez', async () => {
+    const store = testStore();
+    const order = await place(store);
+    await store.orders.payOrder(order.id, 'pix');
+    const onHand = store.inventory.onHand('LIV-001');
+    const results = await Promise.allSettled([
+      store.orders.cancelOrder(order.id, 'a'),
+      store.orders.cancelOrder(order.id, 'b'),
+    ]);
+    assert.deepEqual(results.map((r) => r.status).sort(), ['fulfilled', 'rejected']);
+    assert.equal(results.find((r) => r.status === 'rejected').reason.code, 'ORDER_NOT_CANCELLABLE');
+    assert.equal(store.gateway.refunds.length, 1);
+    assert.equal(store.inventory.onHand('LIV-001'), onHand + 2);
+  });
+});
