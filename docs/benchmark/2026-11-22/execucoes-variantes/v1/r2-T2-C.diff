+
+describe('OrderService.cancelOrder', () => {
+  const item = [{ sku: 'TEC-040', quantity: 2 }];
+  const place = (store) => store.orders.placeOrder({ customer: CUSTOMER, items: item });
+
+  it('pendente: desfaz a reserva, sem estorno, e registra motivo e data', async () => {
+    const store = testStore();
+    const order = await place(store);
+    const result = await store.orders.cancelOrder(order.id, '  desisti  ');
+    assert.equal(result, order);
+    assert.equal(order.status, 'cancelled');
+    assert.equal(order.cancelReason, 'desisti');
+    assert.equal(order.cancelledAt, '2026-03-10T12:00:00.000Z');
+    assert.deepEqual(order.history.at(-1), { status: 'cancelled', at: '2026-03-10T12:00:00.000Z', reason: 'desisti' });
+    assert.equal(order.toJSON().cancelReason, 'desisti');
+    assert.equal(store.inventory.reservationOf(order.id), null);
+    assert.equal(store.inventory.available('TEC-040'), 8);
+    assert.equal(store.gateway.refunds.length, 0);
+    const [event] = store.bus.emitted('order.cancelled');
+    assert.deepEqual(event, { orderId: order.id, email: 'ana@example.com', name: 'Ana Souza', reason: 'desisti', refunded: false });
+  });
+
+  it('pago: estorna uma vez e devolve o estoque físico', async () => {
+    const store = testStore();
+    const order = await store.orders.placeOrder({
+      customer: CUSTOMER,
+      items: [{ sku: 'TEC-040', quantity: 1 }, { sku: 'TEC-040', quantity: 1 }],
+    });
+    await store.orders.payOrder(order.id, 'pix');
+    assert.equal(store.inventory.onHand('TEC-040'), 6);
+    await store.orders.cancelOrder(order.id, 'arrependimento');
+    assert.equal(order.status, 'cancelled');
+    assert.deepEqual(store.gateway.refunds.map(({ paymentId, amount }) => ({ paymentId, amount })), [
+      { paymentId: 'PAY-0001', amount: order.totals.total },
+    ]);
+    assert.equal(store.inventory.onHand('TEC-040'), 8);
+    assert.equal(store.bus.emitted('order.cancelled')[0].refunded, true);
+    await assert.rejects(store.orders.cancelOrder(order.id, 'de novo'), { code: 'ORDER_NOT_CANCELLABLE' });
+    assert.equal(store.gateway.refunds.length, 1);
+  });
+
+  it('estorno recusado: REFUND_FAILED, continua paid e nada muda', async () => {
+    const store = testStore();
+    const order = await place(store);
+    await store.orders.payOrder(order.id, 'pix');
+    store.gateway.refund = async () => ({ ok: false, reason: 'gateway_down' });
+    const before = store.bus.emitted('order.cancelled').length;
+    await assert.rejects(store.orders.cancelOrder(order.id, 'x'), (error) => {
+      assert.equal(error.code, 'REFUND_FAILED');
+      assert.equal(error.details.reason, 'gateway_down');
+      return true;
+    });
+    assert.equal(order.status, 'paid');
+    assert.equal(order.cancelReason, null);
+    assert.equal(store.inventory.onHand('TEC-040'), 6);
+    assert.equal(store.gateway.refunds.length, 0);
+    assert.equal(store.bus.emitted('order.cancelled').length, before);
+    assert.equal(store.orders.cancelling.size, 0);
+  });
+
+  it('valida o motivo antes de qualquer efeito', async () => {
+    const store = testStore();
+    const order = await place(store);
+    for (const reason of [undefined, '', '   ', 42]) {
+      await assert.rejects(store.orders.cancelOrder(order.id, reason), { code: 'VALIDATION_ERROR' });
+    }
+    assert.equal(order.status, 'pending');
+    assert.equal(store.bus.emitted('order.cancelled').length, 0);
+  });
+
+  it('pedido inexistente', async () => {
+    const store = testStore();
+    await assert.rejects(store.orders.cancelOrder('ORD-9999', 'x'), { code: 'ORDER_NOT_FOUND' });
+  });
+
+  it('status não cancelável: shipped, payment_failed e cancelled', async () => {
+    const failing = new FakePaymentGateway({ script: [{ ok: true }, { ok: false, retryable: false, reason: 'card_declined' }] });
+    const store = testStore({ gateway: failing });
+    const shipped = await place(store);
+    await store.orders.payOrder(shipped.id, 'pix');
+    store.orders.shipOrder(shipped.id, 'BR1');
+    const failed = await place(store);
+    await store.orders.payOrder(failed.id, 'pix');
+    const cancelled = await place(store);
+    await store.orders.cancelOrder(cancelled.id, 'a');
+    for (const [order, status] of [[shipped, 'shipped'], [failed, 'payment_failed'], [cancelled, 'cancelled']]) {
+      await assert.rejects(store.orders.cancelOrder(order.id, 'b'), (error) => {
+        assert.equal(error.code, 'ORDER_NOT_CANCELLABLE');
+        assert.equal(error.details.status, status);
+        return true;
+      });
+      assert.equal(order.status, status);
+    }
+    assert.equal(store.gateway.refunds.length, 0);
+    assert.equal(store.bus.emitted('order.cancelled').length, 1);
+  });
+
+  it('cancelamento duplo concorrente estorna uma única vez', async () => {
+    const store = testStore();
+    const order = await place(store);
+    await store.orders.payOrder(order.id, 'pix');
+    const results = await Promise.allSettled([
+      store.orders.cancelOrder(order.id, 'a'),
+      store.orders.cancelOrder(order.id, 'b'),
+    ]);
+    assert.deepEqual(results.map((r) => r.status), ['fulfilled', 'rejected']);
+    assert.equal(results[1].reason.code, 'ORDER_NOT_CANCELLABLE');
+    assert.equal(store.gateway.refunds.length, 1);
+    assert.equal(store.inventory.onHand('TEC-040'), 8);
+    assert.equal(store.bus.emitted('order.cancelled').length, 1);
+  });
+});
