+
+describe('OrderService#cancelOrder', () => {
+  const place = (store, sku = 'CAM-020', quantity = 1) =>
+    store.orders.placeOrder({ customer: CUSTOMER, items: [{ sku, quantity }] });
+
+  it('pendente: desfaz a reserva, sem estorno, e registra motivo, data e histórico', async () => {
+    const store = testStore();
+    const before = store.inventory.available('CAM-020');
+    const order = await place(store);
+    const result = await store.orders.cancelOrder(order.id, '  desisti  ');
+    assert.equal(result, order);
+    assert.equal(order.status, 'cancelled');
+    assert.equal(order.cancelReason, 'desisti');
+    assert.equal(order.cancelledAt, '2026-03-10T12:00:00.000Z');
+    assert.deepEqual(order.history.at(-1), { status: 'cancelled', at: '2026-03-10T12:00:00.000Z', reason: 'desisti' });
+    assert.equal(store.inventory.available('CAM-020'), before);
+    assert.equal(store.inventory.reservationOf(order.id), null);
+    assert.equal(store.gateway.refunds.length, 0);
+    assert.deepEqual(store.bus.emitted('order.cancelled')[0], {
+      orderId: order.id,
+      email: CUSTOMER.email,
+      name: CUSTOMER.name,
+      reason: 'desisti',
+      refunded: false,
+    });
+  });
+
+  it('pago: estorna o total uma vez e devolve os itens ao estoque físico', async () => {
+    const store = testStore();
+    const before = store.inventory.onHand('TEC-040');
+    const order = await place(store, 'TEC-040', 2);
+    await store.orders.payOrder(order.id, 'pix');
+    assert.equal(store.inventory.onHand('TEC-040'), before - 2);
+    await store.orders.cancelOrder(order.id, 'erro no pedido');
+    assert.equal(order.status, 'cancelled');
+    assert.deepEqual(store.gateway.refunds.map(({ paymentId, amount }) => ({ paymentId, amount })), [
+      { paymentId: order.payment.paymentId, amount: order.totals.total },
+    ]);
+    assert.equal(store.inventory.onHand('TEC-040'), before);
+    assert.equal(store.bus.emitted('order.cancelled')[0].refunded, true);
+    await assert.rejects(store.orders.cancelOrder(order.id, 'de novo'), { code: 'ORDER_NOT_CANCELLABLE' });
+    assert.equal(store.gateway.refunds.length, 1);
+  });
+
+  it('cancelamentos simultâneos estornam uma só vez', async () => {
+    const store = testStore();
+    const order = await place(store);
+    await store.orders.payOrder(order.id, 'pix');
+    const results = await Promise.allSettled([
+      store.orders.cancelOrder(order.id, 'a'),
+      store.orders.cancelOrder(order.id, 'b'),
+    ]);
+    assert.deepEqual(results.map((r) => r.status).sort(), ['fulfilled', 'rejected']);
+    assert.equal(store.gateway.refunds.length, 1);
+  });
+
+  it('estorno recusado: REFUND_FAILED, pedido segue pago e estoque intacto', async () => {
+    const store = testStore();
+    const order = await place(store);
+    await store.orders.payOrder(order.id, 'pix');
+    const onHand = store.inventory.onHand('CAM-020');
+    store.gateway.refund = async () => ({ ok: false, reason: 'gateway_down' });
+    await assert.rejects(store.orders.cancelOrder(order.id, 'motivo'), { code: 'REFUND_FAILED' });
+    assert.equal(order.status, 'paid');
+    assert.equal(order.cancelReason, null);
+    assert.equal(store.inventory.onHand('CAM-020'), onHand);
+    assert.equal(store.bus.emitted('order.cancelled').length, 0);
+    assert.deepEqual(order.history.map((h) => h.status), ['pending', 'paid']);
+  });
+
+  it('exige motivo, pedido existente e status cancelável', async () => {
+    const store = testStore();
+    const order = await place(store);
+    for (const reason of [undefined, '', '   ', 5]) {
+      await assert.rejects(store.orders.cancelOrder(order.id, reason), { code: 'VALIDATION_ERROR' });
+    }
+    assert.equal(order.status, 'pending');
+    await assert.rejects(store.orders.cancelOrder('ORD-9999', 'x'), { code: 'ORDER_NOT_FOUND' });
+    await store.orders.payOrder(order.id, 'pix');
+    store.orders.shipOrder(order.id, 'br1');
+    await assert.rejects(store.orders.cancelOrder(order.id, 'x'), { code: 'ORDER_NOT_CANCELLABLE' });
+    store.orders.deliverOrder(order.id);
+    await assert.rejects(store.orders.cancelOrder(order.id, 'x'), { code: 'ORDER_NOT_CANCELLABLE' });
+    const gateway = new FakePaymentGateway({ script: [{ ok: false, retryable: false, reason: 'card_declined' }] });
+    const s2 = testStore({ gateway });
+    const failed = await place(s2);
+    await s2.orders.payOrder(failed.id, 'pix');
+    await assert.rejects(s2.orders.cancelOrder(failed.id, 'x'), { code: 'ORDER_NOT_CANCELLABLE' });
+  });
+
+  it('avisa o cliente com o assunto "Pedido <id> cancelado"', async () => {
+    const store = testStore();
+    const order = await place(store);
+    await store.orders.cancelOrder(order.id, 'mudei de ideia');
+    const message = store.transport.sent.find((m) => m.type === 'order.cancelled');
+    assert.equal(message.to, CUSTOMER.email);
+    assert.equal(message.subject, `Pedido ${order.id} cancelado`);
+    assert.match(message.body, /Ana Souza/);
+    assert.match(message.body, /mudei de ideia/);
+  });
+
+  it('salesReport ignora pedidos cancelados', async () => {
+    const store = testStore();
+    const a = await place(store);
+    const b = await place(store);
+    await store.orders.cancelOrder(a.id, 'x');
+    const { salesReport } = await import('../src/reports/salesReport.js');
+    const report = salesReport(store.orders.listOrders());
+    assert.equal(report.orderCount, 1);
+    assert.equal(report.revenue, b.totals.total);
+  });
+});
