diff --git a/test/cancelOrder.test.js b/test/cancelOrder.test.js
new file mode 100644
index 0000000..9f48ced
--- /dev/null
+++ b/test/cancelOrder.test.js
@@ -0,0 +1,123 @@
+import assert from 'node:assert/strict';
+import { describe, it } from 'node:test';
+
+import { ORDER_STATUSES } from '../src/index.js';
+import { CUSTOMER, testStore } from './helpers.js';
+
+async function pendingOrder(store, sku = 'TEC-040', quantity = 2) {
+  return store.orders.placeOrder({ customer: CUSTOMER, items: [{ sku, quantity }] });
+}
+
+async function paidOrder(store, sku = 'TEC-040', quantity = 2) {
+  const order = await pendingOrder(store, sku, quantity);
+  await store.orders.payOrder(order.id, 'pix');
+  return order;
+}
+
+describe('OrderService#cancelOrder', () => {
+  it('status cancelled existe em ORDER_STATUSES', () => {
+    assert.ok(ORDER_STATUSES.includes('cancelled'));
+  });
+
+  it('pending: libera a reserva, sem estorno', async () => {
+    const store = testStore();
+    const order = await pendingOrder(store);
+    assert.equal(store.inventory.available('TEC-040'), 6);
+    const result = await store.orders.cancelOrder(order.id, 'desistência');
+    assert.equal(result.id, order.id);
+    assert.equal(order.status, 'cancelled');
+    assert.equal(order.cancelReason, 'desistência');
+    assert.equal(order.cancelledAt, '2026-03-10T12:00:00.000Z');
+    assert.equal(store.inventory.available('TEC-040'), 8);
+    assert.equal(store.inventory.onHand('TEC-040'), 8);
+    assert.equal(store.gateway.refunds.length, 0);
+    assert.deepEqual(
+      order.history.map((entry) => entry.status),
+      ['pending', 'cancelled'],
+    );
+    assert.deepEqual(store.bus.emitted('order.cancelled'), [
+      { orderId: order.id, email: CUSTOMER.email, name: CUSTOMER.name, reason: 'desistência', refunded: false },
+    ]);
+  });
+
+  it('paid: estorna o total uma única vez e devolve os itens ao estoque', async () => {
+    const store = testStore();
+    const order = await paidOrder(store);
+    assert.equal(store.inventory.onHand('TEC-040'), 6);
+    await store.orders.cancelOrder(order.id, 'erro no pedido');
+    assert.equal(order.status, 'cancelled');
+    assert.equal(store.gateway.refunds.length, 1);
+    assert.equal(store.gateway.refunds[0].paymentId, order.payment.paymentId);
+    assert.equal(store.gateway.refunds[0].amount, order.totals.total);
+    assert.equal(store.inventory.onHand('TEC-040'), 8);
+    assert.equal(store.inventory.available('TEC-040'), 8);
+    assert.equal(store.bus.emitted('order.cancelled')[0].refunded, true);
+    assert.deepEqual(
+      order.history.map((entry) => entry.status),
+      ['pending', 'paid', 'cancelled'],
+    );
+  });
+
+  it('cancelar de novo não estorna outra vez', async () => {
+    const store = testStore();
+    const order = await paidOrder(store);
+    await store.orders.cancelOrder(order.id, 'motivo');
+    await assert.rejects(store.orders.cancelOrder(order.id, 'motivo'), { code: 'ORDER_NOT_CANCELLABLE' });
+    assert.equal(store.gateway.refunds.length, 1);
+    assert.equal(store.bus.emitted('order.cancelled').length, 1);
+  });
+
+  it('recusa do gateway: REFUND_FAILED, segue paid e estoque intocado', async () => {
+    const store = testStore();
+    const order = await paidOrder(store);
+    store.gateway.refund = async () => ({ ok: false, reason: 'gateway_down' });
+    await assert.rejects(store.orders.cancelOrder(order.id, 'motivo'), { code: 'REFUND_FAILED' });
+    assert.equal(order.status, 'paid');
+    assert.ok(order.cancelReason == null);
+    assert.equal(store.inventory.onHand('TEC-040'), 6);
+    assert.equal(store.inventory.available('TEC-040'), 6);
+    assert.equal(store.bus.emitted('order.cancelled').length, 0);
+  });
+
+  it('motivo vazio ou ausente: VALIDATION_ERROR, pedido intacto', async () => {
+    const store = testStore();
+    const order = await pendingOrder(store);
+    await assert.rejects(store.orders.cancelOrder(order.id, ''), { code: 'VALIDATION_ERROR' });
+    await assert.rejects(store.orders.cancelOrder(order.id, '   '), { code: 'VALIDATION_ERROR' });
+    await assert.rejects(store.orders.cancelOrder(order.id), { code: 'VALIDATION_ERROR' });
+    assert.equal(order.status, 'pending');
+    assert.equal(store.inventory.available('TEC-040'), 6);
+  });
+
+  it('pedido inexistente: ORDER_NOT_FOUND', async () => {
+    const store = testStore();
+    await assert.rejects(store.orders.cancelOrder('ORD-9999', 'motivo'), { code: 'ORDER_NOT_FOUND' });
+  });
+
+  it('shipped, delivered, payment_failed e cancelled: ORDER_NOT_CANCELLABLE', async () => {
+    const store = testStore();
+
+    const shipped = await paidOrder(store, 'CAM-020', 1);
+    store.orders.shipOrder(shipped.id, 'br1');
+    await assert.rejects(store.orders.cancelOrder(shipped.id, 'motivo'), { code: 'ORDER_NOT_CANCELLABLE' });
+    assert.equal(shipped.status, 'shipped');
+
+    const delivered = await paidOrder(store, 'CAM-020', 1);
+    store.orders.shipOrder(delivered.id, 'br2');
+    store.orders.deliverOrder(delivered.id);
+    await assert.rejects(store.orders.cancelOrder(delivered.id, 'motivo'), { code: 'ORDER_NOT_CANCELLABLE' });
+    assert.equal(delivered.status, 'delivered');
+
+    store.gateway.script.push({ ok: false, retryable: false, reason: 'card_declined' });
+    const failed = await pendingOrder(store, 'MOU-030', 1);
+    await store.orders.payOrder(failed.id, 'credit_card');
+    await assert.rejects(store.orders.cancelOrder(failed.id, 'motivo'), { code: 'ORDER_NOT_CANCELLABLE' });
+    assert.equal(failed.status, 'payment_failed');
+
+    const cancelled = await pendingOrder(store, 'CAN-010', 1);
+    await store.orders.cancelOrder(cancelled.id, 'motivo');
+    await assert.rejects(store.orders.cancelOrder(cancelled.id, 'outro'), { code: 'ORDER_NOT_CANCELLABLE' });
+
+    assert.equal(store.gateway.refunds.length, 0);
+  });
+});
