diff --git a/test/cancelOrder.test.js b/test/cancelOrder.test.js
new file mode 100644
index 0000000..57ffb51
--- /dev/null
+++ b/test/cancelOrder.test.js
@@ -0,0 +1,155 @@
+import assert from 'node:assert/strict';
+import { describe, it } from 'node:test';
+
+import { FakePaymentGateway, Inventory, salesReport } from '../src/index.js';
+import { CUSTOMER, testStore } from './helpers.js';
+
+const AT = '2026-03-10T12:00:00.000Z';
+
+async function placed(store, sku = 'TEC-040', quantity = 2) {
+  return store.orders.placeOrder({ customer: CUSTOMER, items: [{ sku, quantity }] });
+}
+
+describe('OrderService#cancelOrder', () => {
+  it('pendente: desfaz a reserva, não estorna e emite order.cancelled', async () => {
+    const store = testStore();
+    const order = await placed(store);
+    const before = store.inventory.onHand('TEC-040');
+    const result = await store.orders.cancelOrder(order.id, 'desisti');
+    assert.equal(result, order);
+    assert.equal(order.status, 'cancelled');
+    assert.equal(store.inventory.reservationOf(order.id), null);
+    assert.equal(store.inventory.available('TEC-040'), before);
+    assert.equal(store.gateway.refunds.length, 0);
+    assert.deepEqual(store.bus.emitted('order.cancelled')[0], {
+      orderId: order.id,
+      email: CUSTOMER.email,
+      name: CUSTOMER.name,
+      reason: 'desisti',
+      refunded: false,
+    });
+    assert.deepEqual(order.history.at(-1), { status: 'cancelled', at: AT, reason: 'desisti' });
+    assert.equal(order.cancelReason, 'desisti');
+    assert.equal(order.cancelledAt, AT);
+    assert.equal(order.toJSON().cancelledAt, AT);
+  });
+
+  it('pago: estorna o total uma vez, restaura o estoque e emite refunded=true', async () => {
+    const store = testStore();
+    const order = await placed(store);
+    await store.orders.payOrder(order.id, 'pix');
+    assert.equal(store.inventory.onHand('TEC-040'), 6);
+    await store.orders.cancelOrder(order.id, 'arrependimento');
+    assert.equal(order.status, 'cancelled');
+    assert.deepEqual(
+      store.gateway.refunds.map(({ paymentId, amount }) => ({ paymentId, amount })),
+      [{ paymentId: 'PAY-0001', amount: order.totals.total }],
+    );
+    assert.equal(store.inventory.onHand('TEC-040'), 8);
+    assert.equal(store.inventory.available('TEC-040'), 8);
+    assert.equal(store.bus.emitted('order.cancelled')[0].refunded, true);
+  });
+
+  it('gateway recusa o estorno: REFUND_FAILED, continua paid, estoque intacto, sem evento', async () => {
+    const gateway = new FakePaymentGateway();
+    gateway.refund = async () => ({ ok: false, reason: 'gateway_down' });
+    const store = testStore({ gateway });
+    const order = await placed(store);
+    await store.orders.payOrder(order.id, 'pix');
+    await assert.rejects(store.orders.cancelOrder(order.id, 'x'), (error) => {
+      assert.equal(error.code, 'REFUND_FAILED');
+      assert.equal(error.details?.reason ?? error.reason, 'gateway_down');
+      return true;
+    });
+    assert.equal(order.status, 'paid');
+    assert.equal(order.cancelReason, null);
+    assert.equal(store.inventory.onHand('TEC-040'), 6);
+    assert.equal(store.bus.emitted('order.cancelled').length, 0);
+  });
+
+  it('exige motivo e pedido existente', async () => {
+    const store = testStore();
+    const order = await placed(store);
+    for (const reason of ['', '  ', undefined]) {
+      await assert.rejects(store.orders.cancelOrder(order.id, reason), { code: 'VALIDATION_ERROR' });
+    }
+    assert.equal(order.status, 'pending');
+    await assert.rejects(store.orders.cancelOrder('ORD-9999', 'x'), { code: 'ORDER_NOT_FOUND' });
+  });
+
+  it('não cancela payment_failed, shipped, delivered nem cancelado', async () => {
+    const gateway = new FakePaymentGateway({ script: [{ ok: false, retryable: false, reason: 'card_declined' }] });
+    const store = testStore({ gateway });
+    const failed = await placed(store, 'MOU-030', 1);
+    await store.orders.payOrder(failed.id, 'credit_card');
+    const shipped = await placed(store, 'CAM-020', 1);
+    await store.orders.payOrder(shipped.id, 'pix');
+    store.orders.shipOrder(shipped.id, 'br1');
+    const delivered = await placed(store, 'CAN-010', 1);
+    await store.orders.payOrder(delivered.id, 'pix');
+    store.orders.shipOrder(delivered.id, 'br2');
+    store.orders.deliverOrder(delivered.id);
+    const cancelled = await placed(store, 'LIV-001', 1);
+    await store.orders.cancelOrder(cancelled.id, 'x');
+
+    for (const [order, status] of [
+      [failed, 'payment_failed'],
+      [shipped, 'shipped'],
+      [delivered, 'delivered'],
+      [cancelled, 'cancelled'],
+    ]) {
+      await assert.rejects(store.orders.cancelOrder(order.id, 'y'), (error) => {
+        assert.equal(error.code, 'ORDER_NOT_CANCELLABLE');
+        assert.equal(error.details?.status ?? error.status, status);
+        return true;
+      });
+    }
+    assert.equal(store.gateway.refunds.length, 0);
+  });
+
+  it('cancelamento concorrente não estorna duas vezes', async () => {
+    const store = testStore();
+    const order = await placed(store);
+    await store.orders.payOrder(order.id, 'pix');
+    const results = await Promise.allSettled([
+      store.orders.cancelOrder(order.id, 'a'),
+      store.orders.cancelOrder(order.id, 'b'),
+    ]);
+    assert.equal(results.filter((r) => r.status === 'fulfilled').length, 1);
+    const rejected = results.find((r) => r.status === 'rejected');
+    assert.equal(rejected.reason.code, 'ORDER_NOT_CANCELLABLE');
+    assert.equal(store.gateway.refunds.length, 1);
+    assert.equal(store.inventory.onHand('TEC-040'), 8);
+    assert.equal(store.bus.emitted('order.cancelled').length, 1);
+  });
+
+  it('notifica o cliente com o assunto do cancelamento', async () => {
+    const store = testStore();
+    const order = await placed(store, 'MON-050', 1);
+    await store.orders.payOrder(order.id, 'pix');
+    await store.orders.cancelOrder(order.id, 'mudei de ideia');
+    const message = store.transport.sent.at(-1);
+    assert.equal(message.subject, 'Pedido ORD-0001 cancelado');
+    assert.ok(message.body.includes('mudei de ideia'));
+    assert.ok(message.body.includes('estornado'));
+  });
+
+  it('salesReport ignora pedidos cancelados', async () => {
+    const store = testStore();
+    const a = await placed(store, 'LIV-001', 1);
+    const b = await placed(store, 'CAN-010', 1);
+    await store.orders.cancelOrder(b.id, 'x');
+    const report = salesReport(store.orders.listOrders());
+    assert.equal(report.orderCount, 1);
+    assert.equal(report.revenue, a.totals.total);
+  });
+});
+
+describe('Inventory#restock', () => {
+  it('soma ao estoque físico sem exigir reserva', () => {
+    const inventory = new Inventory({ stock: { A: 5, B: 1 } });
+    inventory.restock([{ sku: 'A', quantity: 3 }, { sku: 'B', quantity: 2 }]);
+    assert.equal(inventory.onHand('A'), 8);
+    assert.equal(inventory.available('B'), 3);
+  });
+});
