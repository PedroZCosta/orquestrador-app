-export function formatBRL(value) {
-  const [integer, decimals] = round2(value).toFixed(2).split('.');
+function formatFixed(value) {
+  const [integer, decimals] = value.toFixed(2).split('.');
   const grouped = integer.replace(/\B(?=(\d{3})+(?!\d))/g, '.');
   return `R$ ${grouped},${decimals}`;
 }
 
+export function formatBRL(value) {
+  return formatFixed(round2(value));
+}
+
+/** Como formatBRL, mas sem arredondar antes (só toFixed(2)), p.ex. no relatório. */
+export function formatBRLExact(value) {
+  return formatFixed(value);
+}
+
+/** Valor unitário vezes quantidade, arredondado. */
+export function mulMoney(value, quantity) {
+  return round2(value * quantity);
+}
+
 export function sumMoney(values) {
   return round2(values.reduce((total, value) => total + value, 0));
 }
