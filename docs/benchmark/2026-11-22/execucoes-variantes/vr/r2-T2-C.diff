diff --git a/test/orderService.test.js b/test/orderService.test.js
index c3b715c..7e6645a 100644
--- a/test/orderService.test.js
+++ b/test/orderService.test.js
@@ -76,3 +76,95 @@ describe('OrderService', () => {
     assert.throws(() => store.orders.getOrder('ORD-9999'), { code: 'ORDER_NOT_FOUND' });
   });
 });
+
+describe('OrderService.cancelOrder', () => {
+  const items = [{ sku: 'LIV-001', quantity: 2 }];
+  const place = (store) => store.orders.placeOrder({ customer: CUSTOMER, items });
+
+  it('valida o motivo e a existência do pedido', async () => {
+    const store = testStore();
+    const order = await place(store);
+    for (const reason of [undefined, '', '   ']) {
+      await assert.rejects(store.orders.cancelOrder(order.id, reason), { code: 'VALIDATION_ERROR' });
+    }
+    await assert.rejects(store.orders.cancelOrder('ORD-9999', 'x'), { code: 'ORDER_NOT_FOUND' });
+    assert.equal(order.status, 'pending');
+  });
+
+  it('pendente: desfaz a reserva, sem estorno, e notifica', async () => {
+    const store = testStore();
+    const order = await place(store);
+    const result = await store.orders.cancelOrder(order.id, 'desistência');
+    assert.equal(result.status, 'cancelled');
+    assert.equal(result.cancelReason, 'desistência');
+    assert.equal(result.cancelledAt, '2026-03-10T12:00:00.000Z');
+    assert.equal(result.history.at(-1).status, 'cancelled');
+    assert.equal(store.inventory.available('LIV-001'), 20);
+    assert.equal(store.inventory.reservationOf(order.id), null);
+    assert.equal(store.gateway.refunds.length, 0);
+    const [event] = store.bus.emitted('order.cancelled');
+    assert.deepEqual(event, {
+      orderId: order.id,
+      email: CUSTOMER.email,
+      name: CUSTOMER.name,
+      reason: 'desistência',
+      refunded: false,
+    });
+    const msg = store.transport.sent.find((m) => m.type === 'order.cancelled');
+    assert.equal(msg.subject, `Pedido ${order.id} cancelado`);
+    assert.equal(msg.to, CUSTOMER.email);
+  });
+
+  it('pago: estorna uma vez, devolve estoque e emite o evento', async () => {
+    const store = testStore();
+    const order = await place(store);
+    await store.orders.payOrder(order.id, 'pix');
+    assert.equal(store.inventory.onHand('LIV-001'), 18);
+    await store.orders.cancelOrder(order.id, 'erro');
+    assert.equal(store.gateway.refunds.length, 1);
+    assert.equal(store.gateway.refunds[0].paymentId, order.payment.paymentId);
+    assert.equal(store.gateway.refunds[0].amount, order.totals.total);
+    assert.equal(store.inventory.onHand('LIV-001'), 20);
+    assert.equal(store.inventory.available('LIV-001'), 20);
+    assert.equal(store.bus.emitted('order.cancelled').length, 1);
+    await assert.rejects(store.orders.cancelOrder(order.id, 'de novo'), { code: 'ORDER_NOT_CANCELLABLE' });
+    assert.equal(store.gateway.refunds.length, 1);
+  });
+
+  it('chamadas simultâneas estornam só uma vez', async () => {
+    const store = testStore();
+    const order = await place(store);
+    await store.orders.payOrder(order.id, 'pix');
+    const results = await Promise.allSettled([
+      store.orders.cancelOrder(order.id, 'a'),
+      store.orders.cancelOrder(order.id, 'b'),
+    ]);
+    assert.equal(results.filter((r) => r.status === 'fulfilled').length, 1);
+    assert.equal(store.gateway.refunds.length, 1);
+    assert.equal(store.inventory.onHand('LIV-001'), 20);
+  });
+
+  it('estorno recusado: REFUND_FAILED, pedido segue pago e estoque intacto', async () => {
+    const store = testStore();
+    const order = await place(store);
+    await store.orders.payOrder(order.id, 'pix');
+    store.gateway.refund = async () => ({ ok: false, reason: 'gateway_down' });
+    await assert.rejects(store.orders.cancelOrder(order.id, 'erro'), { code: 'REFUND_FAILED' });
+    assert.equal(order.status, 'paid');
+    assert.equal(order.cancelReason, null);
+    assert.equal(store.inventory.onHand('LIV-001'), 18);
+    assert.equal(store.bus.emitted('order.cancelled').length, 0);
+  });
+
+  it('outros status não cancelam', async () => {
+    const store = testStore();
+    const order = await place(store);
+    await store.orders.payOrder(order.id, 'pix');
+    store.orders.shipOrder(order.id, 'tr1');
+    await assert.rejects(store.orders.cancelOrder(order.id, 'x'), { code: 'ORDER_NOT_CANCELLABLE' });
+    const failed = testStore({ gateway: new FakePaymentGateway({ script: [{ ok: false, retryable: false, reason: 'd' }] }) });
+    const o2 = await place(failed);
+    await failed.orders.payOrder(o2.id, 'pix');
+    await assert.rejects(failed.orders.cancelOrder(o2.id, 'x'), { code: 'ORDER_NOT_CANCELLABLE' });
+  });
+});
