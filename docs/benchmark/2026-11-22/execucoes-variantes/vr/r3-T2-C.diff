diff --git a/test/cancelOrder.test.js b/test/cancelOrder.test.js
new file mode 100644
index 0000000..3963e65
--- /dev/null
+++ b/test/cancelOrder.test.js
@@ -0,0 +1,110 @@
+import assert from 'node:assert/strict';
+import { describe, it } from 'node:test';
+
+import { ORDER_STATUSES } from '../src/orders/order.js';
+import { salesReport } from '../src/reports/salesReport.js';
+import { CUSTOMER, testStore } from './helpers.js';
+
+const ITEMS = [{ sku: 'TEC-040', quantity: 2 }];
+
+describe('OrderService#cancelOrder', () => {
+  it('cancela pedido pendente: desfaz a reserva, sem estorno', async () => {
+    const store = testStore();
+    const before = store.inventory.available('TEC-040');
+    const order = await store.orders.placeOrder({ customer: CUSTOMER, items: ITEMS });
+    const result = await store.orders.cancelOrder(order.id, ' mudei de ideia ');
+    assert.equal(result, order);
+    assert.equal(order.status, 'cancelled');
+    assert.equal(order.cancelReason, 'mudei de ideia');
+    assert.equal(order.cancelledAt, '2026-03-10T12:00:00.000Z');
+    assert.deepEqual(order.history.at(-1), { status: 'cancelled', at: order.cancelledAt, reason: 'mudei de ideia' });
+    assert.equal(store.inventory.available('TEC-040'), before);
+    assert.equal(store.inventory.reservationOf(order.id), null);
+    assert.equal(store.gateway.refunds.length, 0);
+    assert.ok(ORDER_STATUSES.includes('cancelled'));
+    const event = store.bus.emitted('order.cancelled');
+    assert.equal(event.length, 1);
+    assert.deepEqual(event[0], {
+      orderId: order.id,
+      email: CUSTOMER.email,
+      name: CUSTOMER.name,
+      reason: 'mudei de ideia',
+      refunded: false,
+    });
+  });
+
+  it('cancela pedido pago: estorna o total uma vez e devolve o estoque', async () => {
+    const store = testStore();
+    const before = store.inventory.onHand('TEC-040');
+    const order = await store.orders.placeOrder({ customer: CUSTOMER, items: ITEMS });
+    await store.orders.payOrder(order.id, 'pix');
+    assert.equal(store.inventory.onHand('TEC-040'), before - 2);
+    await store.orders.cancelOrder(order.id, 'desistência');
+    assert.equal(order.status, 'cancelled');
+    assert.deepEqual(store.gateway.refunds.map(({ paymentId, amount }) => ({ paymentId, amount })), [
+      { paymentId: order.payment.paymentId, amount: order.totals.total },
+    ]);
+    assert.equal(store.inventory.onHand('TEC-040'), before);
+    assert.equal(store.bus.emitted('order.cancelled')[0].refunded, true);
+    await assert.rejects(store.orders.cancelOrder(order.id, 'de novo'), { code: 'ORDER_NOT_CANCELLABLE' });
+    assert.equal(store.gateway.refunds.length, 1);
+  });
+
+  it('chamadas simultâneas estornam uma única vez', async () => {
+    const store = testStore();
+    const order = await store.orders.placeOrder({ customer: CUSTOMER, items: ITEMS });
+    await store.orders.payOrder(order.id, 'pix');
+    const results = await Promise.allSettled([
+      store.orders.cancelOrder(order.id, 'a'),
+      store.orders.cancelOrder(order.id, 'b'),
+    ]);
+    assert.deepEqual(results.map((r) => r.status).sort(), ['fulfilled', 'rejected']);
+    assert.equal(store.gateway.refunds.length, 1);
+    assert.equal(store.inventory.onHand('TEC-040'), 8);
+  });
+
+  it('estorno recusado: REFUND_FAILED, segue paid e estoque intocado', async () => {
+    const store = testStore();
+    const order = await store.orders.placeOrder({ customer: CUSTOMER, items: ITEMS });
+    await store.orders.payOrder(order.id, 'pix');
+    const onHand = store.inventory.onHand('TEC-040');
+    store.gateway.refund = async () => ({ ok: false, reason: 'gateway_down' });
+    await assert.rejects(store.orders.cancelOrder(order.id, 'x'), { code: 'REFUND_FAILED' });
+    assert.equal(order.status, 'paid');
+    assert.equal(order.cancelReason, null);
+    assert.equal(store.inventory.onHand('TEC-040'), onHand);
+    assert.equal(store.bus.emitted('order.cancelled').length, 0);
+    delete store.gateway.refund;
+    await store.orders.cancelOrder(order.id, 'x');
+    assert.equal(order.status, 'cancelled');
+  });
+
+  it('valida o motivo e o pedido, e recusa outros status', async () => {
+    const store = testStore();
+    const order = await store.orders.placeOrder({ customer: CUSTOMER, items: ITEMS });
+    for (const reason of [undefined, '', '   ', 5]) {
+      await assert.rejects(store.orders.cancelOrder(order.id, reason), { code: 'VALIDATION_ERROR' });
+    }
+    assert.equal(order.status, 'pending');
+    await assert.rejects(store.orders.cancelOrder('ORD-9999', 'x'), { code: 'ORDER_NOT_FOUND' });
+    await store.orders.payOrder(order.id, 'pix');
+    store.orders.shipOrder(order.id, 'br1');
+    await assert.rejects(store.orders.cancelOrder(order.id, 'x'), { code: 'ORDER_NOT_CANCELLABLE' });
+    store.orders.deliverOrder(order.id);
+    await assert.rejects(store.orders.cancelOrder(order.id, 'x'), { code: 'ORDER_NOT_CANCELLABLE' });
+  });
+
+  it('avisa o cliente e o salesReport ignora cancelados', async () => {
+    const store = testStore();
+    const a = await store.orders.placeOrder({ customer: CUSTOMER, items: ITEMS });
+    const b = await store.orders.placeOrder({ customer: CUSTOMER, items: [{ sku: 'CAN-010', quantity: 1 }] });
+    await store.orders.cancelOrder(a.id, 'erro no pedido');
+    const message = store.transport.sent.find((m) => m.type === 'order.cancelled');
+    assert.equal(message.subject, `Pedido ${a.id} cancelado`);
+    assert.equal(message.to, CUSTOMER.email);
+    assert.ok(message.body.includes('Ana Souza') && message.body.includes('erro no pedido'));
+    const report = salesReport(store.orders.listOrders());
+    assert.equal(report.orderCount, 1);
+    assert.equal(report.revenue, b.totals.total);
+  });
+});
