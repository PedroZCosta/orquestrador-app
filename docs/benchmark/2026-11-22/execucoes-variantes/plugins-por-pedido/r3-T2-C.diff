diff --git a/test/cancelOrder.test.js b/test/cancelOrder.test.js
new file mode 100644
index 0000000..c819fca
--- /dev/null
+++ b/test/cancelOrder.test.js
@@ -0,0 +1,153 @@
+import assert from 'node:assert/strict';
+import { describe, it } from 'node:test';
+
+import { FakePaymentGateway } from '../src/index.js';
+import { salesReport } from '../src/reports/salesReport.js';
+import { CUSTOMER, testStore } from './helpers.js';
+
+async function pendingOrder(store, sku = 'TEC-040', quantity = 2) {
+  return store.orders.placeOrder({ customer: CUSTOMER, items: [{ sku, quantity }] });
+}
+
+async function paidOrder(store, sku = 'TEC-040', quantity = 2) {
+  const order = await pendingOrder(store, sku, quantity);
+  await store.orders.payOrder(order.id, 'pix');
+  return order;
+}
+
+describe('OrderService#cancelOrder', () => {
+  it('exige o motivo', async () => {
+    const store = testStore();
+    const order = await pendingOrder(store);
+    for (const reason of [undefined, '', '   ', 42]) {
+      await assert.rejects(store.orders.cancelOrder(order.id, reason), { code: 'VALIDATION_ERROR' });
+    }
+    assert.equal(order.status, 'pending');
+  });
+
+  it('pedido inexistente', async () => {
+    const store = testStore();
+    await assert.rejects(store.orders.cancelOrder('ORD-9999', 'desistência'), { code: 'ORDER_NOT_FOUND' });
+  });
+
+  it('pendente: libera a reserva, sem estorno', async () => {
+    const store = testStore();
+    const order = await pendingOrder(store);
+    assert.equal(store.inventory.available('TEC-040'), 6);
+    const result = await store.orders.cancelOrder(order.id, '  mudei de ideia ');
+    assert.equal(result, order);
+    assert.equal(order.status, 'cancelled');
+    assert.equal(store.inventory.available('TEC-040'), 8);
+    assert.equal(store.inventory.onHand('TEC-040'), 8);
+    assert.equal(store.inventory.reservationOf(order.id), null);
+    assert.equal(store.gateway.refunds.length, 0);
+    assert.equal(store.bus.emitted('order.cancelled')[0].refunded, false);
+  });
+
+  it('pago: estorna uma vez com o paymentId e devolve o estoque físico', async () => {
+    const store = testStore();
+    const order = await paidOrder(store);
+    assert.equal(store.inventory.onHand('TEC-040'), 6);
+    await store.orders.cancelOrder(order.id, 'atraso');
+    assert.equal(order.status, 'cancelled');
+    assert.equal(store.gateway.refunds.length, 1);
+    assert.equal(store.gateway.refunds[0].paymentId, 'PAY-0001');
+    assert.equal(store.gateway.refunds[0].amount, order.totals.total);
+    assert.equal(store.inventory.onHand('TEC-040'), 8);
+    assert.equal(store.inventory.available('TEC-040'), 8);
+    assert.equal(store.bus.emitted('order.cancelled')[0].refunded, true);
+  });
+
+  it('cancelamentos simultâneos estornam uma única vez', async () => {
+    const store = testStore();
+    const order = await paidOrder(store);
+    const results = await Promise.allSettled([
+      store.orders.cancelOrder(order.id, 'a'),
+      store.orders.cancelOrder(order.id, 'b'),
+    ]);
+    assert.deepEqual(results.map((item) => item.status).sort(), ['fulfilled', 'rejected']);
+    assert.equal(store.gateway.refunds.length, 1);
+    assert.equal(store.inventory.onHand('TEC-040'), 8);
+  });
+
+  it('gateway recusa o estorno: REFUND_FAILED, segue pago e estoque intacto', async () => {
+    const store = testStore();
+    const order = await paidOrder(store);
+    store.gateway.refund = async () => ({ ok: false, reason: 'gateway_down' });
+    await assert.rejects(store.orders.cancelOrder(order.id, 'atraso'), { code: 'REFUND_FAILED' });
+    assert.equal(order.status, 'paid');
+    assert.equal(order.cancelReason, null);
+    assert.equal(order.cancelledAt, null);
+    assert.equal(order.history.length, 2);
+    assert.equal(store.inventory.onHand('TEC-040'), 6);
+    assert.equal(store.bus.emitted('order.cancelled').length, 0);
+    // pode tentar de novo depois
+    store.gateway.refund = FakePaymentGateway.prototype.refund;
+    await store.orders.cancelOrder(order.id, 'atraso');
+    assert.equal(order.status, 'cancelled');
+  });
+
+  it('só cancela pending ou paid', async () => {
+    const store = testStore();
+    const cancelled = await pendingOrder(store, 'CAN-010', 1);
+    await store.orders.cancelOrder(cancelled.id, 'x');
+    await assert.rejects(store.orders.cancelOrder(cancelled.id, 'de novo'), { code: 'ORDER_NOT_CANCELLABLE' });
+
+    const shipped = await paidOrder(store, 'CAM-020', 1);
+    store.orders.shipOrder(shipped.id, 'br1');
+    await assert.rejects(store.orders.cancelOrder(shipped.id, 'x'), { code: 'ORDER_NOT_CANCELLABLE' });
+    store.orders.deliverOrder(shipped.id);
+    await assert.rejects(store.orders.cancelOrder(shipped.id, 'x'), { code: 'ORDER_NOT_CANCELLABLE' });
+
+    const gateway = new FakePaymentGateway({ script: [{ ok: false, retryable: false, reason: 'card_declined' }] });
+    const failedStore = testStore({ gateway });
+    const failed = await pendingOrder(failedStore, 'MOU-030', 1);
+    await failedStore.orders.payOrder(failed.id, 'credit_card');
+    await assert.rejects(failedStore.orders.cancelOrder(failed.id, 'x'), {
+      code: 'ORDER_NOT_CANCELLABLE',
+    });
+    assert.equal(failedStore.gateway.refunds.length, 0);
+  });
+
+  it('emite order.cancelled e avisa o cliente', async () => {
+    const store = testStore();
+    const order = await paidOrder(store);
+    await store.orders.cancelOrder(order.id, 'atraso');
+    assert.deepEqual(store.bus.emitted('order.cancelled'), [
+      { orderId: order.id, email: 'ana@example.com', name: 'Ana Souza', reason: 'atraso', refunded: true },
+    ]);
+    const message = store.transport.sent.at(-1);
+    assert.equal(message.subject, `Pedido ${order.id} cancelado`);
+    assert.equal(message.to, 'ana@example.com');
+    assert.ok(message.body.includes('atraso'));
+  });
+
+  it('guarda cancelReason, cancelledAt (relógio da loja) e histórico', async () => {
+    const store = testStore();
+    const order = await pendingOrder(store);
+    store.clock.set('2026-03-11T09:30:00.000Z');
+    await store.orders.cancelOrder(order.id, ' sem dinheiro ');
+    assert.equal(order.cancelReason, 'sem dinheiro');
+    assert.equal(order.cancelledAt, '2026-03-11T09:30:00.000Z');
+    assert.equal(order.updatedAt, '2026-03-11T09:30:00.000Z');
+    assert.deepEqual(order.history.at(-1), {
+      status: 'cancelled',
+      at: '2026-03-11T09:30:00.000Z',
+      reason: 'sem dinheiro',
+    });
+    assert.equal(order.toJSON().cancelReason, 'sem dinheiro');
+  });
+
+  it('salesReport ignora pedidos cancelados', async () => {
+    const store = testStore();
+    const kept = await paidOrder(store, 'CAN-010', 1);
+    const dropped = await paidOrder(store, 'LIV-001', 1);
+    const pending = await pendingOrder(store, 'LIV-001', 1);
+    await store.orders.cancelOrder(dropped.id, 'x');
+    await store.orders.cancelOrder(pending.id, 'y');
+    const report = salesReport(store.orders.listOrders());
+    assert.equal(report.orderCount, 1);
+    assert.equal(report.revenue, kept.totals.total);
+    assert.equal(report.bySku['LIV-001'], undefined);
+  });
+});
