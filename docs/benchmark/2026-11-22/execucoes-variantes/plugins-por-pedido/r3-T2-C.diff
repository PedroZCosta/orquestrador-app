+  /**
+   * Cancela um pedido pendente (desfaz a reserva) ou pago (estorna o valor e
+   * devolve os itens ao estoque). O estorno vem antes de qualquer mudança: se
+   * o gateway recusar, o pedido segue pago e o estoque fica como estava.
+   */
+  async cancelOrder(orderId, reason) {
+    const text = requireString(reason, 'reason');
+    const order = this.repository.get(orderId);
+    if (
+      this.cancelling.has(orderId) ||
+      (order.status !== 'pending' && order.status !== 'paid')
+    ) {
+      throw new DomainError('ORDER_NOT_CANCELLABLE', `O pedido ${orderId} está ${order.status}.`, {
+        status: order.status,
+      });
+    }
+    this.cancelling.add(orderId);
+    try {
+      const refunded = order.status === 'paid';
+      let refundId = null;
+      if (refunded) {
+        refundId = await this.refund(order);
+      }
+      const at = this.now().toISOString();
+      order.markCancelled(text, at);
+      if (refunded) {
+        order.payment = { ...order.payment, refundId, refundedAt: at };
+        this.inventory.restock(order.lines);
+      } else {
+        this.inventory.release(orderId);
+      }
+      this.repository.save(order);
+      this.logger?.info('Pedido cancelado', { orderId, refunded });
+      this.bus.emit('order.cancelled', {
+        orderId,
+        email: order.customer.email,
+        name: order.customer.name,
+        reason: text,
+        refunded,
+      });
+      return order;
+    } finally {
+      this.cancelling.delete(orderId);
+    }
+  }
+
+  async refund(order) {
+    let result;
+    try {
+      result = await this.payments.refund({
+        paymentId: order.payment.paymentId,
+        amount: order.totals.total,
+      });
+    } catch (error) {
+      result = { ok: false, reason: error.message };
+    }
+    if (!result.ok) {
+      throw new DomainError('REFUND_FAILED', `O estorno do pedido ${order.id} foi recusado (${result.reason}).`, {
+        orderId: order.id,
+        reason: result.reason,
+      });
+    }
+    return result.refundId;
+  }
+
