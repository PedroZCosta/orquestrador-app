+++ b/test/cancellation.test.js
@@ -0,0 +1,256 @@
+import assert from 'node:assert/strict';
+import { describe, it } from 'node:test';
+
+import { FakePaymentGateway } from '../src/index.js';
+import { CUSTOMER, testStore } from './helpers.js';
+
+const AT = '2026-03-10T12:00:00.000Z';
+
+async function pendingOrder(store, sku = 'TEC-040', quantity = 2) {
+  return store.orders.placeOrder({ customer: CUSTOMER, items: [{ sku, quantity }] });
+}
+
+async function paidOrder(store, sku = 'TEC-040', quantity = 2) {
+  const order = await pendingOrder(store, sku, quantity);
+  await store.orders.payOrder(order.id, 'pix');
+  return order;
+}
+
+class RefusingGateway extends FakePaymentGateway {
+  async refund() {
+    this.refundCalls = (this.refundCalls ?? 0) + 1;
+    return { ok: false, reason: 'gateway_refused' };
+  }
+}
+
+class ThrowingGateway extends FakePaymentGateway {
+  async refund() {
+    throw new Error('rede caiu');
+  }
+}
+
+describe('cancelOrder: validação', () => {
+  for (const [label, reason] of [['vazio', ''], ['ausente', undefined], ['só espaços', '   ']]) {
+    it(`rejeita reason ${label}`, async () => {
+      const store = testStore();
+      const order = await pendingOrder(store);
+      await assert.rejects(store.orders.cancelOrder(order.id, reason), { code: 'VALIDATION_ERROR' });
+      assert.equal(order.status, 'pending');
+    });
+  }
+
+  it('pedido inexistente', async () => {
+    const store = testStore();
+    await assert.rejects(store.orders.cancelOrder('ORD-9999', 'desisti'), { code: 'ORDER_NOT_FOUND' });
+  });
+
+  it('valida o reason antes de checar o status', async () => {
+    const store = testStore();
+    const order = await paidOrder(store);
+    await store.orders.cancelOrder(order.id, 'ok');
+    await assert.rejects(store.orders.cancelOrder(order.id, ''), { code: 'VALIDATION_ERROR' });
+  });
+});
+
+describe('cancelOrder: pedido pendente', () => {
+  it('libera a reserva, não estorna e emite o evento', async () => {
+    const store = testStore();
+    const order = await pendingOrder(store);
+    assert.equal(store.inventory.available('TEC-040'), 6);
+    const result = await store.orders.cancelOrder(order.id, '  mudei de ideia ');
+    assert.equal(result, order);
+    assert.equal(order.status, 'cancelled');
+    assert.equal(store.inventory.available('TEC-040'), 8);
+    assert.equal(store.inventory.onHand('TEC-040'), 8);
+    assert.equal(store.inventory.reservationOf(order.id), null);
+    assert.equal(store.gateway.refunds.length, 0);
+    assert.deepEqual(store.bus.emitted('order.cancelled'), [
+      { orderId: order.id, email: 'ana@example.com', name: 'Ana Souza', reason: 'mudei de ideia', refunded: false },
+    ]);
+  });
+
+  it('grava cancelReason, cancelledAt e histórico com o relógio da loja', async () => {
+    const store = testStore();
+    const order = await pendingOrder(store);
+    store.clock.set('2026-03-11T08:30:00.000Z');
+    await store.orders.cancelOrder(order.id, 'desisti');
+    assert.equal(order.cancelReason, 'desisti');
+    assert.equal(order.cancelledAt, '2026-03-11T08:30:00.000Z');
+    assert.equal(order.updatedAt, '2026-03-11T08:30:00.000Z');
+    assert.deepEqual(order.history.at(-1), { status: 'cancelled', at: '2026-03-11T08:30:00.000Z', reason: 'desisti' });
+    assert.equal(store.repository.get(order.id).status, 'cancelled');
+  });
+
+  it('pedido novo começa com cancelReason e cancelledAt nulos', async () => {
+    const store = testStore();
+    const order = await pendingOrder(store);
+    assert.equal(order.cancelReason, null);
+    assert.equal(order.cancelledAt, null);
+  });
+});
+
+describe('cancelOrder: pedido pago', () => {
+  it('estorna o total uma vez e devolve ao estoque físico', async () => {
+    const store = testStore();
+    const order = await paidOrder(store);
+    assert.equal(store.inventory.onHand('TEC-040'), 6);
+    const stockEvents = store.bus.history.length;
+    await store.orders.cancelOrder(order.id, 'defeito');
+    assert.equal(order.status, 'cancelled');
+    assert.deepEqual(store.gateway.refunds.map(({ paymentId, amount }) => ({ paymentId, amount })), [
+      { paymentId: 'PAY-0001', amount: order.totals.total },
+    ]);
+    assert.equal(store.inventory.onHand('TEC-040'), 8);
+    assert.equal(store.inventory.available('TEC-040'), 8);
+    const emitted = store.bus.history.slice(stockEvents).map((event) => event.type);
+    assert.deepEqual(emitted, ['order.cancelled']);
+    assert.equal(store.bus.emitted('order.cancelled')[0].refunded, true);
+    assert.equal(order.cancelReason, 'defeito');
+    assert.equal(order.cancelledAt, AT);
+  });
+
+  for (const [label, Gateway] of [['recusa', RefusingGateway], ['lança erro', ThrowingGateway]]) {
+    it(`gateway que ${label}: REFUND_FAILED e nada muda`, async () => {
+      const gateway = new Gateway();
+      const store = testStore({ gateway });
+      const order = await paidOrder(store);
+      const historyBefore = structuredClone(order.history);
+      const eventsBefore = store.bus.history.length;
+      const savedBefore = JSON.stringify(store.repository.get(order.id));
+      await assert.rejects(store.orders.cancelOrder(order.id, 'defeito'), (error) => {
+        assert.equal(error.code, 'REFUND_FAILED');
+        assert.ok(error.details.reason);
+        return true;
+      });
+      assert.equal(order.status, 'paid');
+      assert.equal(order.cancelReason, null);
+      assert.equal(order.cancelledAt, null);
+      assert.deepEqual(order.history, historyBefore);
+      assert.equal(store.inventory.onHand('TEC-040'), 6);
+      assert.equal(store.bus.history.length, eventsBefore);
+      assert.equal(JSON.stringify(store.repository.get(order.id)), savedBefore);
+    });
+  }
+
+  it('detalhes do REFUND_FAILED trazem o motivo do gateway', async () => {
+    const store = testStore({ gateway: new RefusingGateway() });
+    const order = await paidOrder(store);
+    await assert.rejects(store.orders.cancelOrder(order.id, 'x'), (error) => error.details.reason === 'gateway_refused');
+    assert.equal(store.gateway.refundCalls, 1);
+  });
+
+  it('pode tentar de novo depois de um estorno recusado', async () => {
+    const store = testStore({ gateway: new RefusingGateway() });
+    const order = await paidOrder(store);
+    await assert.rejects(store.orders.cancelOrder(order.id, 'x'), { code: 'REFUND_FAILED' });
+    await assert.rejects(store.orders.cancelOrder(order.id, 'x'), { code: 'REFUND_FAILED' });
+  });
+
+  it('duas chamadas simultâneas: uma cancela, a outra recebe ORDER_NOT_CANCELLABLE, 1 refund', async () => {
+    const store = testStore();
+    const order = await paidOrder(store);
+    const results = await Promise.allSettled([
+      store.orders.cancelOrder(order.id, 'a'),
+      store.orders.cancelOrder(order.id, 'b'),
+    ]);
+    assert.equal(results.filter((r) => r.status === 'fulfilled').length, 1);
+    const rejected = results.find((r) => r.status === 'rejected');
+    assert.equal(rejected.reason.code, 'ORDER_NOT_CANCELLABLE');
+    assert.equal(store.gateway.refunds.length, 1);
+    assert.equal(store.inventory.onHand('TEC-040'), 8);
+    assert.equal(store.bus.emitted('order.cancelled').length, 1);
+  });
+
+  it('libera o pedido do controle após o estorno recusado', async () => {
+    const store = testStore({ gateway: new RefusingGateway() });
+    const order = await paidOrder(store);
+    await assert.rejects(store.orders.cancelOrder(order.id, 'x'), { code: 'REFUND_FAILED' });
+    assert.equal(store.orders.cancelling.size, 0);
+  });
+});
+
+describe('cancelOrder: status não cancelável', () => {
+  it('payment_failed', async () => {
+    const gateway = new FakePaymentGateway({ script: [{ ok: false, retryable: false, reason: 'card_declined' }] });
+    const store = testStore({ gateway });
+    const order = await pendingOrder(store);
+    await store.orders.payOrder(order.id, 'pix');
+    await assert.rejects(store.orders.cancelOrder(order.id, 'x'), { code: 'ORDER_NOT_CANCELLABLE' });
+  });
+
+  it('shipped', async () => {
+    const store = testStore();
+    const order = await paidOrder(store);
+    store.orders.shipOrder(order.id, 'br1');
+    await assert.rejects(store.orders.cancelOrder(order.id, 'x'), { code: 'ORDER_NOT_CANCELLABLE' });
+    assert.equal(store.gateway.refunds.length, 0);
+  });
+
+  it('delivered', async () => {
+    const store = testStore();
+    const order = await paidOrder(store);
+    store.orders.shipOrder(order.id, 'br1');
+    store.orders.deliverOrder(order.id);
+    await assert.rejects(store.orders.cancelOrder(order.id, 'x'), { code: 'ORDER_NOT_CANCELLABLE' });
+  });
+
+  it('cancelled (duplo) não estorna nem devolve estoque de novo', async () => {
+    const store = testStore();
+    const order = await paidOrder(store);
+    await store.orders.cancelOrder(order.id, 'a');
+    await assert.rejects(store.orders.cancelOrder(order.id, 'b'), { code: 'ORDER_NOT_CANCELLABLE' });
+    assert.equal(store.gateway.refunds.length, 1);
+    assert.equal(store.inventory.onHand('TEC-040'), 8);
+  });
+
+  it('cancelled não vai para outro status', async () => {
+    const store = testStore();
+    const order = await pendingOrder(store);
+    await store.orders.cancelOrder(order.id, 'a');
+    assert.equal(order.canTransitionTo('paid'), false);
+    await assert.rejects(store.orders.payOrder(order.id, 'pix'), { code: 'ORDER_NOT_PAYABLE' });
+  });
+});
+
+describe('Inventory#restock', () => {
+  it('soma onHand por linha sem emitir eventos', async () => {
+    const store = testStore();
+    const before = store.bus.history.length;
+    store.inventory.restock([{ sku: 'TEC-040', quantity: 2 }, { sku: 'CAN-010', quantity: 1 }]);
+    assert.equal(store.inventory.onHand('TEC-040'), 10);
+    assert.equal(store.bus.history.length, before);
+  });
+});
+
+describe('PaymentService#refund', () => {
+  it('repassa ao gateway uma única vez', async () => {
+    const store = testStore();
+    const order = await paidOrder(store);
+    const result = await store.payments.refund({ paymentId: order.payment.paymentId, amount: 10 });
+    assert.equal(result.ok, true);
+    assert.equal(store.gateway.refunds.length, 1);
+  });
+});
+
+describe('Notificação de cancelamento', () => {
+  it('assunto e corpo, com estorno', async () => {
+    const store = testStore();
+    const order = await paidOrder(store, 'MON-050', 1);
+    await store.orders.cancelOrder(order.id, 'defeito');
+    const message = store.transport.sent.find((m) => m.type === 'order.cancelled');
+    assert.equal(message.subject, 'Pedido ORD-0001 cancelado');
+    assert.equal(message.to, 'ana@example.com');
+    assert.ok(message.body.startsWith('Olá, Ana Souza!'));
+    assert.ok(message.body.includes('defeito'));
+    assert.ok(message.body.includes('estornado'));
+  });
+
+  it('sem estorno, não menciona estorno', async () => {
+    const store = testStore();
+    const order = await pendingOrder(store);
+    await store.orders.cancelOrder(order.id, 'desisti');
+    const message = store.transport.sent.find((m) => m.type === 'order.cancelled');
+    assert.ok(message.body.includes('desisti'));
+    assert.ok(!message.body.includes('estornado'));
+  });
+});
