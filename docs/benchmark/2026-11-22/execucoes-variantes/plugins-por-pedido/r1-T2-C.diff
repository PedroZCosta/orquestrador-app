diff --git a/test/cancelOrder.test.js b/test/cancelOrder.test.js
new file mode 100644
index 0000000..20a5db7
--- /dev/null
+++ b/test/cancelOrder.test.js
@@ -0,0 +1,156 @@
+import assert from 'node:assert/strict';
+import { describe, it } from 'node:test';
+
+import { FakePaymentGateway, ORDER_STATUSES } from '../src/index.js';
+import { salesReport } from '../src/reports/salesReport.js';
+import { CUSTOMER, testStore } from './helpers.js';
+
+async function pendingOrder(store, sku = 'TEC-040', quantity = 2) {
+  return store.orders.placeOrder({ customer: CUSTOMER, items: [{ sku, quantity }] });
+}
+
+async function paidOrder(store, sku = 'TEC-040', quantity = 2) {
+  const order = await pendingOrder(store, sku, quantity);
+  await store.orders.payOrder(order.id, 'pix');
+  return order;
+}
+
+describe('OrderService#cancelOrder', () => {
+  it('exige um motivo não vazio', async () => {
+    const store = testStore();
+    const order = await pendingOrder(store);
+    for (const reason of [undefined, '', '   ', 42]) {
+      await assert.rejects(store.orders.cancelOrder(order.id, reason), { code: 'VALIDATION_ERROR' });
+    }
+    assert.equal(order.status, 'pending');
+  });
+
+  it('pedido inexistente', async () => {
+    const store = testStore();
+    await assert.rejects(store.orders.cancelOrder('ORD-9999', 'desistência'), { code: 'ORDER_NOT_FOUND' });
+  });
+
+  it('não cancela pedido enviado, entregue, com pagamento recusado ou já cancelado', async () => {
+    const gateway = new FakePaymentGateway({ script: [{ ok: true }, { ok: true }, { ok: false, retryable: false }] });
+    const store = testStore({ gateway });
+    const shipped = await paidOrder(store, 'CAN-010', 1);
+    store.orders.shipOrder(shipped.id, 'br1');
+    const delivered = await paidOrder(store, 'CAN-010', 1);
+    store.orders.shipOrder(delivered.id, 'br2');
+    store.orders.deliverOrder(delivered.id);
+    const failed = await paidOrder(store, 'CAN-010', 1);
+    const cancelled = await pendingOrder(store, 'CAN-010', 1);
+    await store.orders.cancelOrder(cancelled.id, 'erro');
+
+    for (const order of [shipped, delivered, failed, cancelled]) {
+      await assert.rejects(store.orders.cancelOrder(order.id, 'motivo'), { code: 'ORDER_NOT_CANCELLABLE' });
+    }
+    assert.equal(failed.status, 'payment_failed');
+    assert.equal(store.gateway.refunds.length, 0);
+  });
+
+  it('pendente: cancela, libera a reserva e não estorna', async () => {
+    const store = testStore();
+    const order = await pendingOrder(store);
+    assert.equal(store.inventory.available('TEC-040'), 6);
+    const result = await store.orders.cancelOrder(order.id, '  mudei de ideia ');
+    assert.equal(result, order);
+    assert.equal(order.status, 'cancelled');
+    assert.ok(ORDER_STATUSES.includes('cancelled'));
+    assert.equal(order.cancelReason, 'mudei de ideia');
+    assert.equal(order.cancelledAt, '2026-03-10T12:00:00.000Z');
+    assert.equal(store.inventory.available('TEC-040'), 8);
+    assert.equal(store.inventory.onHand('TEC-040'), 8);
+    assert.equal(store.inventory.reservationOf(order.id), null);
+    assert.equal(store.gateway.refunds.length, 0);
+    assert.deepEqual(
+      order.history.map((entry) => entry.status),
+      ['pending', 'cancelled'],
+    );
+    assert.equal(order.history[1].reason, 'mudei de ideia');
+    assert.equal(order.toJSON().cancelReason, 'mudei de ideia');
+  });
+
+  it('pago: estorna o total uma única vez e devolve os itens ao estoque', async () => {
+    const store = testStore();
+    const order = await paidOrder(store);
+    assert.equal(store.inventory.onHand('TEC-040'), 6);
+    store.clock.advance(60000);
+    await store.orders.cancelOrder(order.id, 'defeito');
+    assert.equal(order.status, 'cancelled');
+    assert.equal(order.cancelledAt, '2026-03-10T12:01:00.000Z');
+    assert.deepEqual(store.gateway.refunds, [
+      { paymentId: 'PAY-0001', amount: order.totals.total, refundId: 'REF-0001' },
+    ]);
+    assert.equal(store.inventory.onHand('TEC-040'), 8);
+    assert.equal(store.inventory.available('TEC-040'), 8);
+    await assert.rejects(store.orders.cancelOrder(order.id, 'de novo'), { code: 'ORDER_NOT_CANCELLABLE' });
+    assert.equal(store.gateway.refunds.length, 1);
+  });
+
+  it('cancelamentos simultâneos do mesmo pedido pago estornam uma vez só', async () => {
+    const store = testStore();
+    const order = await paidOrder(store);
+    const results = await Promise.allSettled([
+      store.orders.cancelOrder(order.id, 'a'),
+      store.orders.cancelOrder(order.id, 'b'),
+    ]);
+    assert.deepEqual(results.map((r) => r.status).sort(), ['fulfilled', 'rejected']);
+    assert.equal(store.gateway.refunds.length, 1);
+    assert.equal(store.inventory.onHand('TEC-040'), 8);
+  });
+
+  it('estorno recusado: REFUND_FAILED, pedido segue pago e estoque intacto', async () => {
+    const store = testStore();
+    const order = await paidOrder(store);
+    store.gateway.refund = async () => ({ ok: false, reason: 'gateway_down' });
+    await assert.rejects(store.orders.cancelOrder(order.id, 'defeito'), (error) => {
+      assert.equal(error.code, 'REFUND_FAILED');
+      assert.equal(error.details.reason, 'gateway_down');
+      return true;
+    });
+    assert.equal(order.status, 'paid');
+    assert.equal(order.cancelReason, null);
+    assert.equal(order.history.length, 2);
+    assert.equal(store.inventory.onHand('TEC-040'), 6);
+    assert.equal(store.bus.emitted('order.cancelled').length, 0);
+    // pode tentar de novo depois
+    delete store.gateway.refund;
+    await store.orders.cancelOrder(order.id, 'defeito');
+    assert.equal(order.status, 'cancelled');
+  });
+
+  it('emite order.cancelled com refunded conforme o caso', async () => {
+    const store = testStore();
+    const pending = await pendingOrder(store, 'CAN-010', 1);
+    const paid = await paidOrder(store, 'CAN-010', 1);
+    await store.orders.cancelOrder(pending.id, 'p');
+    await store.orders.cancelOrder(paid.id, 'q');
+    assert.deepEqual(store.bus.emitted('order.cancelled'), [
+      { orderId: pending.id, email: 'ana@example.com', name: 'Ana Souza', reason: 'p', refunded: false },
+      { orderId: paid.id, email: 'ana@example.com', name: 'Ana Souza', reason: 'q', refunded: true },
+    ]);
+  });
+
+  it('avisa o cliente com o assunto "Pedido <id> cancelado"', async () => {
+    const store = testStore();
+    const order = await paidOrder(store, 'CAN-010', 1);
+    await store.orders.cancelOrder(order.id, 'defeito');
+    const message = store.transport.sent.at(-1);
+    assert.equal(message.subject, `Pedido ${order.id} cancelado`);
+    assert.equal(message.to, 'ana@example.com');
+    assert.equal(message.type, 'order.cancelled');
+    assert.ok(message.body.includes('Olá, Ana Souza.'));
+    assert.ok(message.body.includes('estorno'));
+  });
+
+  it('o relatório de vendas ignora pedidos cancelados', async () => {
+    const store = testStore();
+    const kept = await pendingOrder(store, 'CAN-010', 1);
+    const dropped = await paidOrder(store, 'CAN-010', 1);
+    await store.orders.cancelOrder(dropped.id, 'x');
+    const report = salesReport(store.orders.listOrders());
+    assert.equal(report.orderCount, 1);
+    assert.equal(report.revenue, kept.totals.total);
+  });
+});
