+  /** Estorno único, sem novas tentativas: `{ ok: true, refundId }` ou `{ ok: false, reason }`. */
+  async refund({ paymentId, amount }) {
+    const result = await this.gateway.refund({ paymentId, amount });
+    if (result.ok) {
+      this.logger?.info('Estorno aprovado', { paymentId, amount });
+      return { ok: true, refundId: result.refundId };
+    }
+    this.logger?.warn('Estorno recusado', { paymentId, amount, reason: result.reason });
+    return { ok: false, reason: result.reason };
+  }
 }
